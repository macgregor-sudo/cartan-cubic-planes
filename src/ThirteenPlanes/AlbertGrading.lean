@[expose] public section

/-! Graded Albert systems, their recognition and their subalgebras.

The section results cover ternary gradings, frame contrasts, the cubic and its phase obstruction,
sparsest systems, line rotations, generated subalgebras, frame completion and the defect.
The geometric inputs are simultaneous unitary identification of four complex frames,
frame existence for closed Albert planes, normalization of unbiased Albert pairs, and the
field-count theorem. The corresponding examples realize the hypotheses on the native algebra. -/

noncomputable section

namespace ThirteenPlanes.AlbertGrading.Theorems

open ThirteenPlanes.AlbertGrading ThirteenPlanes.AlbertGrading.Transport

/-! ### Fourier contrast identities -/

theorem frameContrastIdentities : Statements.FrameContrast := frameContrast

theorem frameContrast_witness : ∃ p : Fin 3 → Glennie.Albert, Glennie.Frame p :=
  ⟨_, Graded.nativeCode.frame 0⟩

/-! ### qutrit contrast table -/

theorem fourFrameContrastTable (h : FrameProperties.QutritFourFrames) : Statements.QutritContrastTable :=
  qutritContrastTable h

theorem qutritContrastTable_witness : type_of% Contrast.qutritTable_hypotheses_satisfiable :=
  Contrast.qutritTable_hypotheses_satisfiable

/-! ### ternary grading theorem -/

theorem ternaryGradedSystem : Statements.GradedSystem := gradedSystem_fromFramePairs

theorem ternaryGradedSystem_witness : Statements.ReferenceTernaryGrading ∧ Statements.GradedSystemNative :=
  ⟨referenceTernaryGrading, gradedSystemNative qutritGeneration⟩

/-! ### first-Tits grading and Weyl basis (no hypotheses beyond `U` unitary, `R ∈ SU(3)`; part (i) supplies the
automorphisms quantified in part (iii)) -/

theorem firstTitsGrading : Statements.TitsLemma := titsLemma

/-! ### graded cubic expansion -/

theorem thirteenPlaneCubic : Statements.ThirteenPlaneCubicFull := thirteenPlaneCubicFull

theorem thirteenPlaneCubic_witness : Statements.TernaryGradingExists ∧
    ∀ (sgn : SignedPlaneIndex → Bool) (ζ : SignedPlaneIndex → ℂ),
      type_of% (tits_field_exists sgn ζ) :=
  ⟨ternaryGradingExists, tits_field_exists⟩

/-! ### complex phases of graded plane coefficients -/

theorem noRealCubicPhaseCoordinates : Statements.NoRealPlaneCoordinates := noRealPlaneCoordinates

theorem nonrealCubicPhases_witness :
    Statements.TernaryGradingExists ∧ Statements.NoRealPlaneCoordinatesNative :=
  ⟨ternaryGradingExists, noRealPlaneCoordinatesNative⟩

/-! ### exterior frame normal form -/

theorem exteriorFrameNormalization : Statements.ExteriorFrame := exteriorFrame

theorem exteriorFrame_witness : type_of% exteriorFrame_hypotheses_satisfiable :=
  exteriorFrame_hypotheses_satisfiable

/-! ### recognition of the graded frame system -/

theorem gradedSystemRecognition : Statements.Recognition := recognition

theorem gradedSystemRecognition_witness : type_of% recognition_hypotheses_satisfiable :=
  recognition_hypotheses_satisfiable

/-! ### recognition of systems with 52 positive shares (existence of a minimizer is part of the target) -/

theorem sparsestSystemClassification (h : FrameProperties.NormalFormOctonion) : Statements.Sparsest := sparsest h

/-! ### rotation of four planes on a graded line -/

theorem rotatedPlaneSystems : Recut.Statements.OtherSystems := rotatedSystems_fromFramePairs

theorem rotatedPlaneSystems_witness : type_of% otherSystems_nonvacuous :=
  otherSystems_nonvacuous

/-! ### two-plane subalgebra classification -/

theorem complexWindowSubalgebras : Statements.SubalgebrasContainingComplexWindow :=
  subalgebrasContainingComplexWindow

theorem complexWindowSubalgebra_witness : type_of% subalgebras_nonvacuous := subalgebras_nonvacuous

/-! ### generation by triples of closed planes (frame level, unconditional; plane level of (i),(ii) under the existence
half of the Jordan frame and closed-plane correspondence) -/

theorem generatedJordanSubalgebras : Statements.Generation := generation

theorem generatedJordanSubalgebras_fromPlanes (h : FrameProperties.ClosedPlaneHasFrame) :
    Statements.GenerationTwoPlanes ∧ Statements.GenerationThreePlanes :=
  ⟨generationTwoPlanes h, generationThreePlanes h⟩

theorem generatedJordanSubalgebras_witness : type_of% generation_nonvacuous := generation_nonvacuous

/-! ### completion of twelve Albert frames -/

theorem uniqueAlbertCompletion : Statements.CompletionO := completionO

theorem albertCompletion_witness : type_of% completionO_hypotheses_realized :=
  completionO_hypotheses_realized

/-! ### radial field defect (Section 6) -/

theorem fieldDefectsAndFrameGap (h : FieldClassification.FieldsCount) :
    Statements.DefectAttained ∧ Statements.DefectSeven ∧ Statements.SixFramesGap := propDefect h

theorem fieldDefect_attained (h : FieldClassification.FieldsCount) : Statements.DefectAttained := defectAttained h

theorem sevenFieldDefect : Statements.DefectSeven := defectSeven

theorem sixFrameGap : Statements.SixFramesGap := sixFramesGap

theorem fieldDefects_witness : Defect.sevenCubic ∈ Defect.cubicClass 7 ∧
    ∀ m : ℕ, 1 ≤ m → (Metric.sphere (0 : Defect.Field m) 1).Nonempty :=
  ⟨defectSeven.1, Defect.sphere_nonempty⟩

end ThirteenPlanes.AlbertGrading.Theorems
