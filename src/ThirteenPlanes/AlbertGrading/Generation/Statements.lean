module

public import ThirteenPlanes.NativeFrames
public import ThirteenPlanes.Basic
public import SubalgebraCoordsAndLine

@[expose] public section

/-! Statement types for two-plane subalgebra classification and generation by triples of closed planes (Section 5, subsection
"Subalgebras generated by three planes").

Carriers. two-plane subalgebra classification is stated on the pinned native Albert carrier
`AlbertSequential.Albert` of `albert-sequential-measurements` v2.0.0 (commit `10e5ca8`), whose
unital Jordan subalgebras are `NativeJordanSubalgebra` and whose octonion subalgebras are
`OctSubalgebra`; `jordanSubalgebraH3 K` is the set of Hermitian matrices with off-diagonal
entries in `K`, in the stored coordinates. generation by triples of closed planes is stated on the compact Albert carrier
`Glennie.Albert` used by the native frames, frame planes `nativeFramePlane` in
`V = NativeTraceless`, and thirteen-plane systems `TightNativeCode`. -/

noncomputable section

namespace ThirteenPlanes.AlbertGrading

open AlbertSequential

/-! ### two-plane subalgebra classification -/

/-- The real span `ℂ_u = ℝ + ℝ u` of the unit and `u` in the native octonions. -/
def complexLine (u : Octonion) : Submodule ℝ Octonion :=
  Submodule.span ℝ {octOne, u}

/-- Two-plane subalgebra classification. Let `u` be a unit imaginary octonion and `S` a unital Jordan subalgebra
of the Albert algebra containing every Hermitian matrix whose entries lie in `ℂ_u`. Then `S` is the
set of Hermitian matrices with entries in an octonion subalgebra `K` with `ℂ_u ⊆ K` and
`dim K ∈ {2, 4, 8}`, and `dim S ∈ {9, 15, 27}`. -/
def Statements.SubalgebrasContainingComplexWindow : Prop :=
  ∀ u : Octonion, octonionReal u = 0 → octNormSq u = 1 →
  ∀ S : NativeJordanSubalgebra,
    (∀ x : Albert, (∀ k : Fin 3, x.2 k ∈ complexLine u) → x ∈ S.carrier) →
    ∃ K : OctSubalgebra, complexLine u ≤ K.carrier ∧
      (Module.finrank ℝ K.carrier = 2 ∨ Module.finrank ℝ K.carrier = 4 ∨
        Module.finrank ℝ K.carrier = 8) ∧
      S = jordanSubalgebraH3 K ∧
      (Module.finrank ℝ S.carrier = 9 ∨ Module.finrank ℝ S.carrier = 15 ∨
        Module.finrank ℝ S.carrier = 27)

/-! ### generation by triples of closed planes -/

/-- The unital Jordan subalgebra of the compact Albert algebra generated by a set: the
intersection of all real subspaces containing the set and the unit and closed under the Jordan
product. -/
def generated (X : Set Glennie.Albert) : Submodule ℝ Glennie.Albert :=
  sInf {C : Submodule ℝ Glennie.Albert | X ⊆ C ∧ (1 : Glennie.Albert) ∈ C ∧
    ∀ x ∈ C, ∀ y ∈ C, Glennie.jordan x y ∈ C}

/-- The traceless part of a subspace of the Albert algebra. -/
def tracelessPart (C : Submodule ℝ Glennie.Albert) : Submodule ℝ Glennie.Albert :=
  C ⊓ LinearMap.ker Glennie.traceLinear

/-- Complex Hermitian three-by-three matrices, with the half-anticommutator product. -/
abbrev ComplexHermitian3 := selfAdjoint (Matrix (Fin 3) (Fin 3) ℂ)

/-- Quaternionic Hermitian three-by-three matrices, with the half-anticommutator product. -/
abbrev QuaternionHermitian3 := selfAdjoint (Matrix (Fin 3) (Fin 3) (Quaternion ℝ))

/-- `C` is a copy of `H₃(ℂ)`: the range of an injective, unit-preserving real-linear map from the
complex Hermitian matrices carrying the half-anticommutator to the Jordan product and the real
matrix trace to the Albert trace. -/
def IsComplexCopy (C : Submodule ℝ Glennie.Albert) : Prop :=
  ∃ φ : ComplexHermitian3 →ₗ[ℝ] Glennie.Albert, Function.Injective φ ∧ LinearMap.range φ = C ∧
    φ 1 = 1 ∧
    (∀ x y z : ComplexHermitian3,
      (z : Matrix (Fin 3) (Fin 3) ℂ) = (1 / 2 : ℝ) • ((x : Matrix (Fin 3) (Fin 3) ℂ) * y + y * x) →
      φ z = Glennie.jordan (φ x) (φ y)) ∧
    ∀ x : ComplexHermitian3, Glennie.trace (φ x) = (Matrix.trace (x : Matrix (Fin 3) (Fin 3) ℂ)).re

/-- `C` is a copy of `H₃(ℍ)`, in the same sense, with the real part of the quaternionic trace. -/
def IsQuaternionicCopy (C : Submodule ℝ Glennie.Albert) : Prop :=
  ∃ φ : QuaternionHermitian3 →ₗ[ℝ] Glennie.Albert, Function.Injective φ ∧ LinearMap.range φ = C ∧
    φ 1 = 1 ∧
    (∀ x y z : QuaternionHermitian3,
      (z : Matrix (Fin 3) (Fin 3) (Quaternion ℝ)) =
        (1 / 2 : ℝ) • ((x : Matrix (Fin 3) (Fin 3) (Quaternion ℝ)) * y + y * x) →
      φ z = Glennie.jordan (φ x) (φ y)) ∧
    ∀ x : QuaternionHermitian3,
      Glennie.trace (φ x) = ∑ i, ((x : Matrix (Fin 3) (Fin 3) (Quaternion ℝ)) i i).re

/-- Generation by triples of closed planes (i). The frames of two orthogonal closed frame planes of `V` generate a copy of
`H₃(ℂ)`, whose traceless part has dimension `8`. -/
def Statements.GenerationTwo : Prop :=
  ∀ p q : Fin 3 → Glennie.Albert, Glennie.Frame p → Glennie.Frame q →
    (nativeFramePlane p).IsOrtho (nativeFramePlane q) →
    IsComplexCopy (generated (Set.range p ∪ Set.range q)) ∧
      Module.finrank ℝ (tracelessPart (generated (Set.range p ∪ Set.range q))) = 8

/-- Generation by triples of closed planes (ii). The frames of three pairwise orthogonal closed frame planes generate a
copy of `H₃(ℂ)`, of `H₃(ℍ)`, or the whole Albert algebra, with traceless part of dimension `8`,
`14` or `26` respectively. -/
def Statements.GenerationThree : Prop :=
  ∀ p q r : Fin 3 → Glennie.Albert, Glennie.Frame p → Glennie.Frame q → Glennie.Frame r →
    (nativeFramePlane p).IsOrtho (nativeFramePlane q) →
    (nativeFramePlane p).IsOrtho (nativeFramePlane r) →
    (nativeFramePlane q).IsOrtho (nativeFramePlane r) →
    let G := generated (Set.range p ∪ Set.range q ∪ Set.range r)
    (IsComplexCopy G ∧ Module.finrank ℝ (tracelessPart G) = 8) ∨
      (IsQuaternionicCopy G ∧ Module.finrank ℝ (tracelessPart G) = 14) ∨
      (G = ⊤ ∧ Module.finrank ℝ (tracelessPart G) = 26)

/-- Generation by triples of closed planes (iii). In a thirteen-plane system (thirteen pairwise unbiased frames), for every
pair of planes at least seven of the other eleven planes generate the Albert algebra together with
the pair. -/
def Statements.GenerationCount : Prop :=
  ∀ c : TightNativeCode, ∀ i j : Fin 13, i ≠ j →
    7 ≤ (Finset.univ.filter fun k : Fin 13 => k ≠ i ∧ k ≠ j ∧
      generated (Set.range (c.point i) ∪ Set.range (c.point j) ∪ Set.range (c.point k)) = ⊤).card

/-! Plane-level readings of parts (i) and (ii) use a frame spanning each given
closed plane, supplied by the existence clause of the Jordan frame and closed-plane correspondence. -/

/-- Jordan frame and closed-plane correspondence, existence half: every closed two-dimensional subspace of `V` is the plane of a
Jordan frame. -/
def FrameProperties.ClosedPlaneHasFrame : Prop :=
  ∀ U : Submodule ℝ NativeTraceless, Module.finrank ℝ U = 2 → IsClosedPiece nativeEqualCubic U →
    ∃ p : Fin 3 → Glennie.Albert, Glennie.Frame p ∧ U = nativeFramePlane p

/-- Generation by triples of closed planes (i) for planes: two orthogonal closed planes of `V` have frames, and the frames
of any such choice generate a copy of `H₃(ℂ)` with traceless part of dimension `8`. -/
def Statements.GenerationTwoPlanes : Prop :=
  ∀ U U' : Submodule ℝ NativeTraceless, Module.finrank ℝ U = 2 → Module.finrank ℝ U' = 2 →
    IsClosedPiece nativeEqualCubic U → IsClosedPiece nativeEqualCubic U' → U.IsOrtho U' →
    (∃ p q : Fin 3 → Glennie.Albert, Glennie.Frame p ∧ Glennie.Frame q ∧
      U = nativeFramePlane p ∧ U' = nativeFramePlane q) ∧
    ∀ p q : Fin 3 → Glennie.Albert, Glennie.Frame p → Glennie.Frame q →
      U = nativeFramePlane p → U' = nativeFramePlane q →
      IsComplexCopy (generated (Set.range p ∪ Set.range q)) ∧
        Module.finrank ℝ (tracelessPart (generated (Set.range p ∪ Set.range q))) = 8

/-- Generation by triples of closed planes (ii) for planes. -/
def Statements.GenerationThreePlanes : Prop :=
  ∀ U U' U'' : Submodule ℝ NativeTraceless, Module.finrank ℝ U = 2 → Module.finrank ℝ U' = 2 →
    Module.finrank ℝ U'' = 2 → IsClosedPiece nativeEqualCubic U →
    IsClosedPiece nativeEqualCubic U' → IsClosedPiece nativeEqualCubic U'' →
    U.IsOrtho U' → U.IsOrtho U'' → U'.IsOrtho U'' →
    (∃ p q r : Fin 3 → Glennie.Albert, Glennie.Frame p ∧ Glennie.Frame q ∧ Glennie.Frame r ∧
      U = nativeFramePlane p ∧ U' = nativeFramePlane q ∧ U'' = nativeFramePlane r) ∧
    ∀ p q r : Fin 3 → Glennie.Albert, Glennie.Frame p → Glennie.Frame q → Glennie.Frame r →
      U = nativeFramePlane p → U' = nativeFramePlane q → U'' = nativeFramePlane r →
      let G := generated (Set.range p ∪ Set.range q ∪ Set.range r)
      (IsComplexCopy G ∧ Module.finrank ℝ (tracelessPart G) = 8) ∨
        (IsQuaternionicCopy G ∧ Module.finrank ℝ (tracelessPart G) = 14) ∨
        (G = ⊤ ∧ Module.finrank ℝ (tracelessPart G) = 26)

/-- Generation by triples of closed planes, all three parts. -/
def Statements.Generation : Prop :=
  Statements.GenerationTwo ∧ Statements.GenerationThree ∧ Statements.GenerationCount

end ThirteenPlanes.AlbertGrading
