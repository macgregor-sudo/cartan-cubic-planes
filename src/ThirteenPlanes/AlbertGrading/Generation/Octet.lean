module

public import ThirteenPlanes.AlbertGrading.Generation.Count
public import ThirteenPlanes.Shares.OctetClosure

@[expose] public section

/-! The subalgebra generated by two unbiased frames is `ℝ1 ⊕ (U ⊕ U' ⊕ W_{UU'})`, of dimension
nine. This uses the pair-octet closure `pairOctet_closed` (closure assertion of
the two-plane octet theorem) and the mixed Gram lemma on the native Albert cubic. -/

noncomputable section

namespace ThirteenPlanes.AlbertGrading

open ThirteenPlanes.RoundCubics

/-- The pair octet `U ⊕ U' ⊕ W_{UU'}` of two frame planes, inside `V`. -/
def pairOctet (p q : Fin 3 → Glennie.Albert) : Submodule ℝ NativeTraceless :=
  (nativeFramePlane p ⊔ nativeFramePlane q) ⊔
    mixedProductSpace nativeEqualCubic (nativeFramePlane p) (nativeFramePlane q)

/-- `ℝ1` plus the pair octet, inside the Albert algebra. -/
def pairNine (p q : Fin 3 → Glennie.Albert) : Submodule ℝ Glennie.Albert :=
  Submodule.span ℝ {(1 : Glennie.Albert)} ⊔
    (pairOctet p q).map (LinearMap.ker Glennie.traceLinear).subtype

theorem framePlane_closedPiece {p : Fin 3 → Glennie.Albert} (hp : Glennie.Frame p) :
    IsClosedPiece nativeEqualCubic (nativeFramePlane p) := by
  intro x y hx hy
  change nativeCenteredJordan x y ∈ nativeFramePlane p
  exact nativeFramePlane_closed hp hx hy

theorem nativeEqualCubic_L_coe (x y : NativeTraceless) :
    ((nativeEqualCubic.L x y : NativeTraceless) : Glennie.Albert) =
      Glennie.jordan x y - (Glennie.trace (Glennie.jordan x y) / 3) • (1 : Glennie.Albert) := rfl

theorem pairOctet_closed' {p q : Fin 3 → Glennie.Albert} (hp : Glennie.Frame p)
    (hq : Glennie.Frame q) (h : (nativeFramePlane p).IsOrtho (nativeFramePlane q)) :
    IsClosedPiece nativeEqualCubic (pairOctet p q) :=
  pairOctet_closed nativeEqualCubic_round h (framePlane_closedPiece hp) (framePlane_closedPiece hq)
    (nativeFramePlane_dimension hp) (nativeFramePlane_dimension hq)

theorem pairOctet_finrank {p q : Fin 3 → Glennie.Albert} (hp : Glennie.Frame p)
    (hq : Glennie.Frame q) (h : (nativeFramePlane p).IsOrtho (nativeFramePlane q)) :
    Module.finrank ℝ (pairOctet p q) = 8 := by
  set U := nativeFramePlane p
  set U' := nativeFramePlane q
  set W := mixedProductSpace nativeEqualCubic U U'
  have hU := nativeFramePlane_dimension hp
  have hU' := nativeFramePlane_dimension hq
  have hW : Module.finrank ℝ W = 4 :=
    mixedProductSpace_finrank nativeEqualCubic_round h (framePlane_closedPiece hp)
      (framePlane_closedPiece hq) hU hU'
  have hWperp : W ≤ (U ⊔ U')ᗮ :=
    mixedProductSpace_le_orthogonal nativeEqualCubic_round h (framePlane_closedPiece hp)
      (framePlane_closedPiece hq)
  have h1 := Submodule.finrank_sup_add_finrank_inf_eq U U'
  have hinf1 : U ⊓ U' = ⊥ := disjoint_iff.mp h.disjoint
  rw [hinf1, finrank_bot, hU, hU'] at h1
  have h2 := Submodule.finrank_sup_add_finrank_inf_eq (U ⊔ U') W
  have hinf2 : (U ⊔ U') ⊓ W = ⊥ := by
    apply eq_bot_iff.mpr
    calc (U ⊔ U') ⊓ W ≤ (U ⊔ U') ⊓ (U ⊔ U')ᗮ := inf_le_inf_left _ hWperp
      _ = ⊥ := Submodule.inf_orthogonal_eq_bot _
  rw [hinf2, finrank_bot, hW] at h2
  change Module.finrank ℝ ↥((U ⊔ U') ⊔ W) = 8
  omega

theorem traceless_add_third (x : Glennie.Albert) :
    Glennie.traceless x + (Glennie.trace x / 3) • (1 : Glennie.Albert) = x := by
  simp [Glennie.traceless]

/-- Two unbiased frames generate exactly `ℝ1 ⊕ (U ⊕ U' ⊕ W_{UU'})`. -/
theorem generated_two_eq {p q : Fin 3 → Glennie.Albert} (hp : Glennie.Frame p)
    (hq : Glennie.Frame q) (h : (nativeFramePlane p).IsOrtho (nativeFramePlane q)) :
    generated (Set.range p ∪ Set.range q) = pairNine p q := by
  set O := pairOctet p q
  set K := LinearMap.ker Glennie.traceLinear
  have one_mem : (1 : Glennie.Albert) ∈ pairNine p q :=
    Submodule.mem_sup_left (Submodule.mem_span_singleton_self _)
  have oct_mem {o : NativeTraceless} (ho : o ∈ O) : (o : Glennie.Albert) ∈ pairNine p q :=
    Submodule.mem_sup_right ⟨o, ho, rfl⟩
  have smul_one_mem (c : ℝ) : c • (1 : Glennie.Albert) ∈ pairNine p q :=
    (pairNine p q).smul_mem c one_mem
  have frame_mem {s : Fin 3 → Glennie.Albert} (hs : Glennie.Frame s)
      (hsO : nativeFramePlane s ≤ O) (a : Fin 3) : s a ∈ pairNine p q := by
    rw [← traceless_add_third (s a)]
    exact (pairNine p q).add_mem (oct_mem (hsO (center_mem_framePlane hs a))) (smul_one_mem _)
  have hUO : nativeFramePlane p ≤ O := le_sup_left.trans le_sup_left
  have hU'O : nativeFramePlane q ≤ O := le_sup_right.trans le_sup_left
  have hclosed := pairOctet_closed' hp hq h
  apply le_antisymm
  · apply generated_le
    · rintro x (⟨a, rfl⟩ | ⟨a, rfl⟩)
      · exact frame_mem hp hUO a
      · exact frame_mem hq hU'O a
    · exact one_mem
    · intro x hx y hy
      obtain ⟨a₁, ha₁, m₁, hm₁, rfl⟩ := Submodule.mem_sup.mp hx
      obtain ⟨a₂, ha₂, m₂, hm₂, rfl⟩ := Submodule.mem_sup.mp hy
      obtain ⟨α, rfl⟩ := Submodule.mem_span_singleton.mp ha₁
      obtain ⟨β, rfl⟩ := Submodule.mem_span_singleton.mp ha₂
      obtain ⟨o₁, ho₁, rfl⟩ := hm₁
      obtain ⟨o₂, ho₂, rfl⟩ := hm₂
      have hoo : Glennie.jordan (o₁ : Glennie.Albert) o₂ ∈ pairNine p q := by
        have hL := nativeEqualCubic_L_coe o₁ o₂
        rw [← traceless_add_third (Glennie.jordan (o₁ : Glennie.Albert) o₂)]
        refine (pairNine p q).add_mem ?_ (smul_one_mem _)
        have hmem := oct_mem (hclosed ho₁ ho₂)
        rw [hL] at hmem
        exact hmem
      have hexp : Glennie.jordan (α • (1 : Glennie.Albert) + K.subtype o₁)
          (β • (1 : Glennie.Albert) + K.subtype o₂) =
          (α * β) • (1 : Glennie.Albert) + α • (o₂ : Glennie.Albert) + β • (o₁ : Glennie.Albert) +
            Glennie.jordan (o₁ : Glennie.Albert) o₂ := by
        simp only [Glennie.jordan_add_left, Glennie.jordan_add_right, Glennie.jordan_smul_left,
          Glennie.jordan_smul_right, Glennie.jordan_unit_left, Glennie.jordan_unit_right,
          Submodule.subtype_apply]
        module
      rw [hexp]
      refine (pairNine p q).add_mem ((pairNine p q).add_mem ((pairNine p q).add_mem ?_ ?_) ?_) hoo
      · exact smul_one_mem _
      · exact (pairNine p q).smul_mem _ (oct_mem ho₂)
      · exact (pairNine p q).smul_mem _ (oct_mem ho₁)
  · set G := generated (Set.range p ∪ Set.range q)
    have g1 : (1 : Glennie.Albert) ∈ G := one_mem_generated _
    have gp (a : Fin 3) : p a ∈ G := subset_generated _ (Or.inl ⟨a, rfl⟩)
    have gq (a : Fin 3) : q a ∈ G := subset_generated _ (Or.inr ⟨a, rfl⟩)
    have plane_le {s : Fin 3 → Glennie.Albert} (hs : Glennie.Frame s) (gs : ∀ a, s a ∈ G) :
        nativeFramePlane s ≤ G.comap K.subtype := by
      rintro x ⟨u, rfl⟩
      change ((nativeFrameChart s u : NativeTraceless) : Glennie.Albert) ∈ G
      rw [nativeFrameChart_coe hs]
      change (∑ b, (nativeFrameEntries u) b • s b) ∈ G
      exact G.sum_mem fun b _ => G.smul_mem _ (gs b)
    have hUG := plane_le hp gp
    have hU'G := plane_le hq gq
    apply sup_le
    · exact (Submodule.span_le).mpr (Set.singleton_subset_iff.mpr g1)
    · rw [Submodule.map_le_iff_le_comap]
      refine sup_le (sup_le hUG hU'G) ?_
      rw [mixedProductSpace_eq_span]
      apply Submodule.map₂_le.mpr
      intro x hx y hy
      change ((nativeEqualCubic.L x y : NativeTraceless) : Glennie.Albert) ∈ G
      rw [nativeEqualCubic_L_coe]
      exact G.sub_mem (jordan_mem_generated _ (hUG hx) (hU'G hy)) (G.smul_mem _ g1)

theorem pairNine_finrank {p q : Fin 3 → Glennie.Albert} (hp : Glennie.Frame p)
    (hq : Glennie.Frame q) (h : (nativeFramePlane p).IsOrtho (nativeFramePlane q)) :
    Module.finrank ℝ (pairNine p q) = 9 := by
  set K := LinearMap.ker Glennie.traceLinear
  set M := (pairOctet p q).map K.subtype
  have hM : Module.finrank ℝ M = 8 := by
    rw [← pairOctet_finrank hp hq h]
    exact (Submodule.equivMapOfInjective K.subtype (Submodule.injective_subtype K) _).finrank_eq.symm
  have hone : (1 : Glennie.Albert) ≠ 0 := by
    intro h0
    have := congrArg Glennie.trace h0
    simp [Glennie.trace] at this
    norm_num at this
  have hS : Module.finrank ℝ (Submodule.span ℝ {(1 : Glennie.Albert)}) = 1 :=
    finrank_span_singleton hone
  have hinf : Submodule.span ℝ {(1 : Glennie.Albert)} ⊓ M = ⊥ := by
    rw [eq_bot_iff]
    rintro x ⟨hx1, hxM⟩
    obtain ⟨c, rfl⟩ := Submodule.mem_span_singleton.mp hx1
    obtain ⟨o, _, ho⟩ := hxM
    have htr : Glennie.trace (c • (1 : Glennie.Albert)) = 0 := by
      rw [← ho]; exact o.2
    rw [Glennie.trace_smul, Glennie.trace_unit] at htr
    have hc : c = 0 := by linarith
    rw [hc, zero_smul]
    exact Submodule.zero_mem _
  have h2 := Submodule.finrank_sup_add_finrank_inf_eq (Submodule.span ℝ {(1 : Glennie.Albert)}) M
  rw [hinf, finrank_bot, hS, hM] at h2
  change Module.finrank ℝ ↥(Submodule.span ℝ {(1 : Glennie.Albert)} ⊔ M) = 9
  omega

/-- The subalgebra generated by two unbiased frames has dimension nine. -/
theorem generated_two_finrank {p q : Fin 3 → Glennie.Albert} (hp : Glennie.Frame p)
    (hq : Glennie.Frame q) (h : (nativeFramePlane p).IsOrtho (nativeFramePlane q)) :
    Module.finrank ℝ (generated (Set.range p ∪ Set.range q)) = 9 := by
  rw [generated_two_eq hp hq h, pairNine_finrank hp hq h]

end ThirteenPlanes.AlbertGrading
