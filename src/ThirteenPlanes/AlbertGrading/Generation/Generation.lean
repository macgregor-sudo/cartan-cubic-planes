module

public import ThirteenPlanes.AlbertGrading.Generation.Subalgebras
public import ThirteenPlanes.AlbertGrading.Generation.Octet
public import ThirteenPlanes.AlbertGrading.Generation.Classify

@[expose] public section

set_option backward.privateInPublic true

/-! Jordan subalgebras generated by pairs and triples of planes.

Two unbiased frames generate the nine-dimensional subalgebra `ℝ1 ⊕ (U ⊕ U' ⊕ W_{UU'})` by pair-octet
closure and the mixed Gram identity. A proper algebra of dimension at least nine containing
them is complex or quaternionic Hermitian by the compact Albert subalgebra classification. -/

noncomputable section

namespace ThirteenPlanes.AlbertGrading

open AlbertSequential

private theorem generated_ne_top_of_finrank {X : Set Glennie.Albert}
    (h : Module.finrank ℝ (generated X) ≠ 27) :
    (generatedSubalgebra (coordEquiv.symm '' X)).carrier ≠ ⊤ := by
  intro htop
  apply h
  rw [generated_eq_map, (map_coordEquiv_eq_top_iff _).mpr htop, finrank_top, Glennie.albert_finrank]

private theorem frame_mem_generated {X : Set Glennie.Albert} {s : Fin 3 → Glennie.Albert}
    (hs : Set.range s ⊆ X) (a : Fin 3) :
    coordEquiv.symm (s a) ∈ (generatedSubalgebra (coordEquiv.symm '' X)).carrier :=
  subset_generatedSubalgebra _ ⟨s a, hs ⟨a, rfl⟩, rfl⟩

/-- Generation by triples of closed planes (i). -/
theorem generationTwo : Statements.GenerationTwo := by
  intro p q hp hq h
  have hpq := unbiased_of_ortho hp hq h
  set X := Set.range p ∪ Set.range q
  set B := generatedSubalgebra (coordEquiv.symm '' X)
  have h9 := generated_two_finrank hp hq h
  have hmap : generated X = B.carrier.map (coordEquiv : Albert →ₗ[ℝ] Glennie.Albert) :=
    generated_eq_map X
  have hB9 : Module.finrank ℝ B.carrier = 9 := by
    rw [← finrank_map_coordEquiv, ← hmap, h9]
  have hB : B.carrier ≠ ⊤ := generated_ne_top_of_finrank (by rw [h9]; norm_num)
  have ht := finrank_tracelessPart (generated X) (one_mem_generated X)
  rcases classify hp hq hpq B (frame_mem_generated Set.subset_union_left)
      (frame_mem_generated Set.subset_union_right) hB hB9.ge with ⟨_, hc⟩ | ⟨h15, _⟩
  · refine ⟨hmap ▸ hc, ?_⟩
    have h9' : Module.finrank ℝ (generated X) = 9 := h9
    rw [h9'] at ht
    omega
  · rw [hB9] at h15
    norm_num at h15

/-- Generation by triples of closed planes (ii). -/
theorem generationThree : Statements.GenerationThree := by
  intro p q r hp hq hr hpq' hpr' hqr'
  dsimp only
  have hpq := unbiased_of_ortho hp hq hpq'
  set X := Set.range p ∪ Set.range q ∪ Set.range r
  set B := generatedSubalgebra (coordEquiv.symm '' X)
  have hmap : generated X = B.carrier.map (coordEquiv : Albert →ₗ[ℝ] Glennie.Albert) :=
    generated_eq_map X
  have h9 : 9 ≤ Module.finrank ℝ (generated X) := by
    rw [← generated_two_finrank hp hq hpq']
    exact Submodule.finrank_mono (generated_mono Set.subset_union_left)
  have ht := finrank_tracelessPart (generated X) (one_mem_generated X)
  by_cases htop : generated X = ⊤
  · right; right
    refine ⟨htop, ?_⟩
    rw [htop] at ht ⊢
    rw [finrank_top, Glennie.albert_finrank] at ht
    omega
  · have hB : B.carrier ≠ ⊤ := by
      intro h
      apply htop
      rw [hmap, (map_coordEquiv_eq_top_iff _).mpr h]
    have hBfin : Module.finrank ℝ B.carrier = Module.finrank ℝ (generated X) := by
      rw [hmap, finrank_map_coordEquiv]
    have hpX : Set.range p ⊆ X := Set.subset_union_left.trans Set.subset_union_left
    have hqX : Set.range q ⊆ X := Set.subset_union_right.trans Set.subset_union_left
    rcases classify hp hq hpq B (frame_mem_generated hpX) (frame_mem_generated hqX) hB
        (by rw [hBfin]; exact h9) with ⟨h9', hc⟩ | ⟨h15, hc⟩
    · left
      refine ⟨hmap ▸ hc, ?_⟩
      rw [← hBfin, h9'] at ht
      omega
    · right; left
      refine ⟨hmap ▸ hc, ?_⟩
      rw [← hBfin, h15] at ht
      omega

/-- Generation by triples of closed planes (i), plane-level reading, under the existence half of the Jordan frame and closed-plane correspondence. -/
theorem generationTwoPlanes (hframe : FrameProperties.ClosedPlaneHasFrame) :
    Statements.GenerationTwoPlanes := by
  intro U U' hU hU' cU cU' hUU'
  refine ⟨?_, ?_⟩
  · obtain ⟨p, hp, rfl⟩ := hframe U hU cU
    obtain ⟨q, hq, rfl⟩ := hframe U' hU' cU'
    exact ⟨p, q, hp, hq, rfl, rfl⟩
  · rintro p q hp hq rfl rfl
    exact generationTwo p q hp hq hUU'

/-- Generation by triples of closed planes (ii), plane-level reading, under the existence half of the Jordan frame and closed-plane correspondence. -/
theorem generationThreePlanes (hframe : FrameProperties.ClosedPlaneHasFrame) :
    Statements.GenerationThreePlanes := by
  intro U U' U'' hU hU' hU'' cU cU' cU'' h1 h2 h3
  refine ⟨?_, ?_⟩
  · obtain ⟨p, hp, rfl⟩ := hframe U hU cU
    obtain ⟨q, hq, rfl⟩ := hframe U' hU' cU'
    obtain ⟨r, hr, rfl⟩ := hframe U'' hU'' cU''
    exact ⟨p, q, r, hp, hq, hr, rfl, rfl, rfl⟩
  · rintro p q r hp hq hr rfl rfl rfl
    exact generationThree p q r hp hq hr h1 h2 h3

/-- Generation by triples of closed planes. -/
theorem generation : Statements.Generation :=
  ⟨generationTwo, generationThree, generationCount⟩

end ThirteenPlanes.AlbertGrading
