module

public import ThirteenPlanes.AlbertGrading.Grading.GradedIncidence

@[expose] public section

set_option backward.privateInPublic true

/-! # ternary grading theorem (v) and the assembled ternary grading theorem

For a line `ℓ`, `Q_ℓ = ℝ e ⊕ ⨁_{p∈ℓ} P_p` is closed under the Jordan product (grading), contains
the four frames of `ℓ`, equals the unital subalgebra generated by two of them, and is therefore
isomorphic to `H₃(ℂ)` by the qutrit generated by two planes (i) (taken as the hypothesis
`Section3.QutritGeneration`). Its traceless part is closed. -/

namespace ThirteenPlanes.AlbertGrading.Grading

open JC ThirteenPlanes.RoundCubics ThirteenPlanes.Graded

noncomputable section

variable {ρ : TernaryAction}

/-- The point of a nonzero grade. -/
def pointOf {k : Charge} (hk : k ≠ 0) : SignedPlaneIndex := (signedPlaneGradeEquiv.symm ⟨k, hk⟩).1

theorem pointOf_rep {k : Charge} (hk : k ≠ 0) : (pointOf hk).val.val = k ∨ (pointOf hk).val.val = -k := by
  have h := signedPlaneGradeEquiv.apply_symm_apply (⟨k, hk⟩ : NonzeroCharge)
  unfold pointOf
  generalize signedPlaneGradeEquiv.symm ⟨k, hk⟩ = s at h
  obtain ⟨p, b⟩ := s
  cases b
  · left
    have := congrArg Subtype.val h
    simpa using this
  · right
    have := congrArg Subtype.val h
    simp [oppositeCharge] at this
    rw [← this, neg_neg]

theorem onLine_of_rep {l : SignedPlaneIndex} {s : SignedPlaneIndex} {k : Charge}
    (hs : s.val.val = k ∨ s.val.val = -k) (hk : chargeDot l.val.val k = 0) :
    signedPointOnLine s l := by
  unfold signedPointOnLine
  rcases hs with hs | hs <;> rw [hs]
  · exact hk
  · rw [chargeDot_neg_right, hk, neg_zero]

theorem mem_lineAlgebra_of_plane {l p : SignedPlaneIndex} (hp : signedPointOnLine p l) {x : Glennie.Albert}
    (hx : x ∈ gradedPlaneJ ρ p.val.val) : x ∈ lineAlgebraOf ρ l :=
  Submodule.subset_span (Or.inr (Set.mem_iUnion₂.mpr ⟨p, hp, hx⟩))

theorem one_mem_lineAlgebra (l : SignedPlaneIndex) : (1 : Glennie.Albert) ∈ lineAlgebraOf ρ l :=
  Submodule.subset_span (Or.inl rfl)

theorem gradedPlaneJ_le_lineAlgebra {l : SignedPlaneIndex} {k : Charge} (hk : k ≠ 0)
    (hl : chargeDot l.val.val k = 0) : gradedPlaneJ ρ k ≤ lineAlgebraOf ρ l := by
  intro x hx
  have hs := pointOf_rep hk
  apply mem_lineAlgebra_of_plane (onLine_of_rep hs hl)
  rcases hs with hs | hs
  · rw [hs]; exact hx
  · rw [hs, gradedPlaneJ_neg]; exact hx

theorem dot_add_of_onLine {l p q : SignedPlaneIndex} (hp : signedPointOnLine p l)
    (hq : signedPointOnLine q l) : chargeDot l.val.val (p.val.val + q.val.val) = 0 := by
  unfold signedPointOnLine at hp hq
  rw [chargeDot_add_right, hp, hq, add_zero]

theorem dot_sub_of_onLine {l p q : SignedPlaneIndex} (hp : signedPointOnLine p l)
    (hq : signedPointOnLine q l) : chargeDot l.val.val (p.val.val - q.val.val) = 0 := by
  unfold signedPointOnLine at hp hq
  rw [sub_eq_add_neg, chargeDot_add_right, chargeDot_neg_right, hp, hq, neg_zero, add_zero]

private theorem gen_gen (hρ : IsTernaryGrading ρ) (l : SignedPlaneIndex) {x y : Glennie.Albert}
    (hx : x ∈ ({1} ∪ ⋃ (p : SignedPlaneIndex) (_ : signedPointOnLine p l),
      (gradedPlaneJ ρ p.val.val : Set Glennie.Albert)))
    (hy : y ∈ lineAlgebraOf ρ l) (hy' : y ∈ ({1} ∪ ⋃ (p : SignedPlaneIndex) (_ : signedPointOnLine p l),
      (gradedPlaneJ ρ p.val.val : Set Glennie.Albert))) :
    Glennie.jordan x y ∈ lineAlgebraOf ρ l := by
  rcases hx with rfl | hx
  · rw [Glennie.jordan_unit_left]; exact hy
  rcases hy' with rfl | hy'
  · rw [Glennie.jordan_unit_right]
    exact Submodule.subset_span (Or.inr hx)
  obtain ⟨p, hp, hx⟩ := Set.mem_iUnion₂.mp hx
  obtain ⟨q, hq, hy'⟩ := Set.mem_iUnion₂.mp hy'
  by_cases hpq : p = q
  · subst hpq
    have h := jordan_mem_of_same hρ hx hy'
    have hle : (ℝ ∙ (1 : Glennie.Albert)) ⊔ gradedPlaneJ ρ p.val.val ≤ lineAlgebraOf ρ l :=
      sup_le (by rw [Submodule.span_le, Set.singleton_subset_iff]; exact one_mem_lineAlgebra l)
        (fun z hz => mem_lineAlgebra_of_plane hp hz)
    exact hle h
  · have h := jordan_mem_of_independent hρ hx hy'
    exact (sup_le (gradedPlaneJ_le_lineAlgebra rep_add_ne_zero (dot_add_of_onLine hp hq))
      (gradedPlaneJ_le_lineAlgebra (rep_sub_ne_zero hpq) (dot_sub_of_onLine hp hq))) h

/-- `Q_ℓ` is closed under the Jordan product. -/
theorem lineAlgebra_closed (hρ : IsTernaryGrading ρ) (l : SignedPlaneIndex) {x y : Glennie.Albert}
    (hx : x ∈ lineAlgebraOf ρ l) (hy : y ∈ lineAlgebraOf ρ l) :
    Glennie.jordan x y ∈ lineAlgebraOf ρ l := by
  -- first for generators `y`
  have step : ∀ y, y ∈ ({1} ∪ ⋃ (p : SignedPlaneIndex) (_ : signedPointOnLine p l),
      (gradedPlaneJ ρ p.val.val : Set Glennie.Albert)) →
      ∀ x, x ∈ lineAlgebraOf ρ l → Glennie.jordan x y ∈ lineAlgebraOf ρ l := by
    intro y hy' x hx
    have hy : y ∈ lineAlgebraOf ρ l := Submodule.subset_span hy'
    induction hx using Submodule.span_induction with
    | mem x hx => exact gen_gen hρ l hx hy hy'
    | zero => rw [Glennie.jordan_zero_left]; exact Submodule.zero_mem _
    | add x x' _ _ h h' => rw [Glennie.jordan_add_left]; exact Submodule.add_mem _ h h'
    | smul a x _ h => rw [Glennie.jordan_smul_left]; exact Submodule.smul_mem _ a h
  induction hy using Submodule.span_induction with
  | mem y hy => exact step y hy x hx
  | zero => rw [Glennie.jordan_zero_right]; exact Submodule.zero_mem _
  | add y y' _ _ h h' => rw [Glennie.jordan_add_right]; exact Submodule.add_mem _ h h'
  | smul a y _ h => rw [Glennie.jordan_smul_right]; exact Submodule.smul_mem _ a h

theorem pointPlane_le_lineTraceless {l : SignedPlaneIndex} {k : Charge} (hk : k ≠ 0)
    (hl : chargeDot l.val.val k = 0) : gradedPlane ρ k ≤ lineTracelessOf ρ l := by
  intro x hx
  have hs := pointOf_rep hk
  apply Submodule.subset_span
  refine Set.mem_iUnion₂.mpr ⟨pointOf hk, onLine_of_rep hs hl, ?_⟩
  change x ∈ pointPlane ρ (pointOf hk)
  rw [pointPlane_of_rep _ hs]; exact hx

/-- `Q_ℓ^0` is closed under the cubic product. -/
theorem lineTraceless_closed (hρ : IsTernaryGrading ρ) (l : SignedPlaneIndex) :
    IsClosedPiece nativeEqualCubic (lineTracelessOf ρ l) := by
  have gg : ∀ x y, x ∈ (⋃ (p : SignedPlaneIndex) (_ : signedPointOnLine p l),
      (pointPlane ρ p : Set NativeTraceless)) → y ∈ (⋃ (p : SignedPlaneIndex)
      (_ : signedPointOnLine p l), (pointPlane ρ p : Set NativeTraceless)) →
      nativeEqualCubic.L x y ∈ lineTracelessOf ρ l := by
    intro x y hx hy
    obtain ⟨p, hp, hx⟩ := Set.mem_iUnion₂.mp hx
    obtain ⟨q, hq, hy⟩ := Set.mem_iUnion₂.mp hy
    by_cases hpq : p = q
    · subst hpq
      exact Submodule.subset_span (Set.mem_iUnion₂.mpr ⟨p, hp,
        gradedPlane_closed hρ (rep_ne_zero p) hx hy⟩)
    · have h : nativeEqualCubic.L x y ∈
          mixedProductSpace nativeEqualCubic (pointPlane ρ p) (pointPlane ρ q) := by
        rw [mixedProductSpace_eq_span]; exact Submodule.apply_mem_map₂ _ hx hy
      rw [mixed_eq hρ hpq] at h
      exact (sup_le (pointPlane_le_lineTraceless rep_add_ne_zero (dot_add_of_onLine hp hq))
        (pointPlane_le_lineTraceless (rep_sub_ne_zero hpq) (dot_sub_of_onLine hp hq))) h
  intro x y hx hy
  have step : ∀ y, y ∈ (⋃ (p : SignedPlaneIndex) (_ : signedPointOnLine p l),
      (pointPlane ρ p : Set NativeTraceless)) → ∀ x, x ∈ lineTracelessOf ρ l →
      nativeEqualCubic.L x y ∈ lineTracelessOf ρ l := by
    intro y hy x hx
    induction hx using Submodule.span_induction with
    | mem x hx => exact gg x y hx hy
    | zero => rw [map_zero, LinearMap.zero_apply]; exact Submodule.zero_mem _
    | add x x' _ _ h h' => rw [map_add, LinearMap.add_apply]; exact Submodule.add_mem _ h h'
    | smul a x _ h => rw [map_smul, LinearMap.smul_apply]; exact Submodule.smul_mem _ a h
  induction hy using Submodule.span_induction with
  | mem y hy => exact step y hy x hx
  | zero => rw [map_zero]; exact Submodule.zero_mem _
  | add y y' _ _ h h' => rw [map_add]; exact Submodule.add_mem _ h h'
  | smul a y _ h => rw [map_smul]; exact Submodule.smul_mem _ a h

/-- Frames of a point on `ℓ` lie in `Q_ℓ`. -/
theorem frame_mem_lineAlgebra (hρ : IsTernaryGrading ρ) {l p : SignedPlaneIndex}
    (hp : signedPointOnLine p l) {u : JC} (hu : u ∈ charSpace ρ p.val.val) (hun : IsNormalized u)
    {P : Fin 3 → Glennie.Albert} (hP : IsFrameOf u P) (a : Fin 3) : P a ∈ lineAlgebraOf ρ l := by
  have e : P a = framePointReal u a := of_injective (by rw [hP.2, of_framePointReal])
  rw [e, show framePointReal u a = (1 / 3 : ℝ) • (1 : Glennie.Albert) +
    (framePointReal u a - (1 / 3 : ℝ) • (1 : Glennie.Albert)) by abel]
  exact Submodule.add_mem _ (Submodule.smul_mem _ _ (one_mem_lineAlgebra l))
    (mem_lineAlgebra_of_plane hp (framePointReal_sub_mem hu a))

/-! ## The generated subalgebra -/

theorem mem_generated_of {s : Set Glennie.Albert} {x : Glennie.Albert}
    (h : ∀ S : Submodule ℝ Glennie.Albert, (1 : Glennie.Albert) ∈ S → s ⊆ S →
      (∀ x y, x ∈ S → y ∈ S → Glennie.jordan x y ∈ S) → x ∈ S) : x ∈ generatedSubalgebra s := by
  rw [generatedSubalgebra, Submodule.mem_sInf]
  rintro S ⟨h1, h2, h3⟩
  exact h S h1 h2 h3

theorem one_mem_generated (s : Set Glennie.Albert) : (1 : Glennie.Albert) ∈ generatedSubalgebra s :=
  mem_generated_of fun _ h1 _ _ => h1

theorem subset_generated (s : Set Glennie.Albert) : s ⊆ generatedSubalgebra s :=
  fun _ hx => mem_generated_of fun _ _ h2 _ => h2 hx

theorem jordan_mem_generated {s : Set Glennie.Albert} {x y : Glennie.Albert}
    (hx : x ∈ generatedSubalgebra s) (hy : y ∈ generatedSubalgebra s) :
    Glennie.jordan x y ∈ generatedSubalgebra s := by
  apply mem_generated_of
  intro S h1 h2 h3
  rw [generatedSubalgebra, Submodule.mem_sInf] at hx hy
  exact h3 _ _ (hx S ⟨h1, h2, h3⟩) (hy S ⟨h1, h2, h3⟩)

/-- A frame plane lies in the subalgebra generated by the frame. -/
theorem plane_le_generated {F : Fin 3 → Glennie.Albert} (hF : Glennie.Frame F) {s : Set Glennie.Albert}
    (hs : Set.range F ⊆ s) (x : NativeTraceless) (hx : x ∈ nativeFramePlane F) :
    (x : Glennie.Albert) ∈ generatedSubalgebra s := by
  obtain ⟨v, rfl⟩ := hx
  rw [nativeFrameChart_coe hF]
  change ∑ b, nativeFrameEntries v b • F b ∈ _
  exact Submodule.sum_mem _ fun b _ => Submodule.smul_mem _ _
    (subset_generated s (hs (Set.mem_range_self b)))

/-- `Q_ℓ` is the unital subalgebra generated by the frames of two of its points. -/
theorem lineAlgebra_eq_generated (hρ : IsTernaryGrading ρ) {l p q : SignedPlaneIndex}
    (hp : signedPointOnLine p l) (hq : signedPointOnLine q l) (hpq : p ≠ q) :
    generatedSubalgebra (Set.range (framePointReal (pointUnit hρ p)) ∪
      Set.range (framePointReal (pointUnit hρ q))) = lineAlgebraOf ρ l := by
  have hFp := isFrameOf_framePointReal hρ (rep_ne_zero p) (pointUnit_spec hρ p).1
    (pointUnit_spec hρ p).2
  have hFq := isFrameOf_framePointReal hρ (rep_ne_zero q) (pointUnit_spec hρ q).1
    (pointUnit_spec hρ q).2
  set s := Set.range (framePointReal (pointUnit hρ p)) ∪ Set.range (framePointReal (pointUnit hρ q))
  apply le_antisymm
  · apply sInf_le
    refine ⟨one_mem_lineAlgebra l, ?_, fun x y hx hy => lineAlgebra_closed hρ l hx hy⟩
    rintro _ (⟨a, rfl⟩ | ⟨a, rfl⟩)
    · exact frame_mem_lineAlgebra hρ hp (pointUnit_spec hρ p).1 (pointUnit_spec hρ p).2 hFp a
    · exact frame_mem_lineAlgebra hρ hq (pointUnit_spec hρ q).1 (pointUnit_spec hρ q).2 hFq a
  · -- planes of `p` and `q`
    have hPp : ∀ x : NativeTraceless, x ∈ pointPlane ρ p → (x : Glennie.Albert) ∈ generatedSubalgebra s := by
      intro x hx
      rw [pointPlane_eq_nativeFramePlane hρ p] at hx
      exact plane_le_generated hFp.1 Set.subset_union_left x hx
    have hPq : ∀ x : NativeTraceless, x ∈ pointPlane ρ q → (x : Glennie.Albert) ∈ generatedSubalgebra s := by
      intro x hx
      rw [pointPlane_eq_nativeFramePlane hρ q] at hx
      exact plane_le_generated hFq.1 Set.subset_union_right x hx
    have hmix : ∀ x : NativeTraceless, x ∈ mixedProductSpace nativeEqualCubic (pointPlane ρ p)
        (pointPlane ρ q) → (x : Glennie.Albert) ∈ generatedSubalgebra s := by
      intro x hx
      rw [mixedProductSpace_eq_span] at hx
      have hle : Submodule.map₂ nativeEqualCubic.L (pointPlane ρ p) (pointPlane ρ q) ≤
          (generatedSubalgebra s).comap Glennie.traceLinear.ker.subtype := by
        apply Submodule.map₂_le.mpr
        intro y hy z hz
        show Glennie.traceless (Glennie.jordan y z) ∈ generatedSubalgebra s
        rw [Glennie.traceless]
        exact Submodule.sub_mem _ (jordan_mem_generated (hPp y hy) (hPq z hz))
          (Submodule.smul_mem _ _ (one_mem_generated s))
      exact hle hx
    rw [lineAlgebraOf, Submodule.span_le]
    rintro x (rfl | hx)
    · exact one_mem_generated s
    obtain ⟨r, hr, hx⟩ := Set.mem_iUnion₂.mp hx
    have hx0 : x ∈ Glennie.traceLinear.ker := gradedPlaneJ_le_ker hρ (rep_ne_zero r) hx
    have hxr : (⟨x, hx0⟩ : NativeTraceless) ∈ pointPlane ρ r := hx
    by_cases hrp : r = p
    · subst hrp; exact hPp _ hxr
    by_cases hrq : r = q
    · subst hrq; exact hPq _ hxr
    have hcol : signedCollinear p q r := ⟨l, hp, hq, hr⟩
    have hle : pointPlane ρ r ≤ gradedPlane ρ (p.val.val + q.val.val) ⊔
        gradedPlane ρ (p.val.val - q.val.val) := by
      rcases rep_of_collinear hpq (Ne.symm hrp) (Ne.symm hrq) hcol with A | A | A | A
      · rw [pointPlane_of_rep r (Or.inl A)]; exact le_sup_left
      · rw [pointPlane_of_rep r (Or.inr A)]; exact le_sup_left
      · rw [pointPlane_of_rep r (Or.inl A)]; exact le_sup_right
      · rw [pointPlane_of_rep r (Or.inr A)]; exact le_sup_right
    exact hmix ⟨x, hx0⟩ (by rw [mixed_eq hρ hpq]; exact hle hxr)

end

end ThirteenPlanes.AlbertGrading.Grading
