module

public import ThirteenPlanes.AlbertGrading.Grading.Complexification
public import ThirteenPlanes.Graded.Incidence
public import ThirteenPlanes.Graded.FullLineModel

@[expose] public section

/-! # Targets for ternary grading theorem, graded cubic expansion and complex phases of graded plane coefficients (Section 5)

Carrier: the native compact Albert algebra `Glennie.Albert` (the paper's `J`), its traceless
part `NativeTraceless` (`V`) with the trace cubic `nativeEqualCubic` (`d`, so that
`d(x,y,z) = ⟨x * y, z⟩`), and the complexification `JC` (`J_ℂ`) of
`Grading/Complexification.lean`, with complex-bilinear product `JC.mul`, form `JC.ip` and
conjugation `JC.conj`.

A ternary grading group `E ⊂ Aut(J)` together with an identification of its character group
with `G = 𝔽₃³` is encoded by an injective homomorphism `ρ : 𝔽₃³ → GL(J)` whose values are
product-preserving: `E` is its image, and the character `g ∈ G` takes the value
`ω^{s·g}` on `ρ(s)`. Every subgroup `E ≅ (ℤ/3)³` with every identification of characters arises
this way. Points of `PG(2,3)` are the `SignedPlaneIndex` (one representative
`p.val.val` of each pair `{g,-g}`), lines are labelled by a normal vector, and collinearity is
`signedCollinear`. -/

namespace ThirteenPlanes.AlbertGrading

open Grading Grading.JC ThirteenPlanes.RoundCubics ThirteenPlanes.Graded

noncomputable section

namespace Grading

/-- An automorphism of `J`: a real-linear bijection preserving the Jordan product. -/
def IsJordanAutomorphism (φ : Glennie.Albert ≃ₗ[ℝ] Glennie.Albert) : Prop :=
  ∀ x y, φ (Glennie.jordan x y) = Glennie.jordan (φ x) (φ y)

/-- An action of `G = 𝔽₃³` on `J` by real-linear bijections. -/
abbrev TernaryAction := Multiplicative Charge →* (Glennie.Albert ≃ₗ[ℝ] Glennie.Albert)

/-- The complex-linear extension of `ρ(s)` to `J_ℂ`. -/
def act (ρ : TernaryAction) (s : Charge) : JC →ₗ[ℂ] JC :=
  mapC (ρ (Multiplicative.ofAdd s)).toLinearMap

/-- The character `g` of `G`, evaluated at `s`: `ω^{s·g}`. -/
def gradeCharacter (s g : Charge) : ℂ := chargePhase (chargeDot s g)

/-- The character space `A_g ⊂ J_ℂ`. -/
def charSpace (ρ : TernaryAction) (g : Charge) : Submodule ℂ JC where
  carrier := {z | ∀ s, act ρ s z = gradeCharacter s g • z}
  add_mem' {z w} hz hw s := by
    rw [map_add, hz s, hw s, smul_add]
  zero_mem' s := by rw [map_zero, smul_zero]
  smul_mem' c z hz s := by
    rw [map_smul, hz s, smul_comm]

/-- A ternary grading group of `J`: `ρ` is injective, takes values in `Aut(J)`, and every one of the
27 characters has a one-dimensional eigenspace on `J_ℂ`. -/
structure IsTernaryGrading (ρ : TernaryAction) : Prop where
  injective : Function.Injective ρ
  automorphism : ∀ s, IsJordanAutomorphism (ρ s)
  lineDim : ∀ g, Module.finrank ℂ (charSpace ρ g) = 1

/-- The normalization `u ∘ u = ū`, `u ∘ ū = e`. -/
def IsNormalized (u : JC) : Prop := mul u u = conj u ∧ mul u (conj u) = one

/-- Outcomes `a ∈ 𝔽₃`, written `Fin 3` for the frame index. -/
def outcome (a : Fin 3) : ZMod 3 := a

/-- `p_a = ⅓(e + ω^{-a} u + ω^a ū)`. -/
def framePoint (u : JC) (a : Fin 3) : JC :=
  (1 / 3 : ℂ) • (one + chargePhase (-(outcome a)) • u + chargePhase (outcome a) • conj u)

/-- The contrast `u_f = Σ_a ω^a p_{fa}` of an ordered frame. -/
def contrast (p : Fin 3 → Glennie.Albert) : JC :=
  ∑ a, chargePhase (outcome a) • of (p a)

/-- `p` is the ordered frame of `J` with points `p_a = ⅓(e + ω^{-a} u + ω^a ū)`. -/
def IsFrameOf (u : JC) (p : Fin 3 → Glennie.Albert) : Prop :=
  Glennie.Frame p ∧ ∀ a, of (p a) = framePoint u a

/-- `J ∩ (A_g ⊕ A_{-g})`. -/
def gradedPlaneJ (ρ : TernaryAction) (g : Charge) : Submodule ℝ Glennie.Albert :=
  ((charSpace ρ g ⊔ charSpace ρ (-g)).restrictScalars ℝ).comap ofLinear

/-- The same space viewed inside `V`. -/
def gradedPlane (ρ : TernaryAction) (g : Charge) : Submodule ℝ NativeTraceless :=
  (gradedPlaneJ ρ g).comap Glennie.traceLinear.ker.subtype

/-- The plane `P_p` of a point `p = {g,-g}`. -/
def pointPlane (ρ : TernaryAction) (p : SignedPlaneIndex) : Submodule ℝ NativeTraceless :=
  gradedPlane ρ p.val.val

/-- `Q_ℓ = ℝ e ⊕ ⨁_{p ∈ ℓ} P_p`. -/
def lineAlgebraOf (ρ : TernaryAction) (l : SignedPlaneIndex) : Submodule ℝ Glennie.Albert :=
  Submodule.span ℝ ({1} ∪ ⋃ (p : SignedPlaneIndex) (_ : signedPointOnLine p l),
    (gradedPlaneJ ρ p.val.val : Set Glennie.Albert))

/-- `Q_ℓ^0 = ⨁_{p ∈ ℓ} P_p`. -/
def lineTracelessOf (ρ : TernaryAction) (l : SignedPlaneIndex) : Submodule ℝ NativeTraceless :=
  Submodule.span ℝ (⋃ (p : SignedPlaneIndex) (_ : signedPointOnLine p l),
    (pointPlane ρ p : Set NativeTraceless))

/-- The unital subalgebra of `J` generated by a set. -/
def generatedSubalgebra (s : Set Glennie.Albert) : Submodule ℝ Glennie.Albert :=
  sInf {S | (1 : Glennie.Albert) ∈ S ∧ s ⊆ S ∧
    ∀ x y, x ∈ S → y ∈ S → Glennie.jordan x y ∈ S}

/-- The unit of `H₃(ℂ)`. -/
def hermitianOne : FullHermitian3 := ⟨1, Matrix.isHermitian_one⟩

end Grading

/-- Qutrit generated by two planes (i) on `J = H₃(𝕆)`, without its frame-labelling clause (which is not used):
for two frames whose planes are orthogonal, the unital subalgebra generated by their points is
isomorphic to `H₃(ℂ)`. -/
def FrameProperties.QutritGeneration : Prop :=
  ∀ F G : Fin 3 → Glennie.Albert, Glennie.Frame F → Glennie.Frame G →
    (nativeFramePlane F).IsOrtho (nativeFramePlane G) →
    ∃ I : FullHermitian3 ≃ₗ[ℝ] generatedSubalgebra (Set.range F ∪ Set.range G),
      (I hermitianOne).val = 1 ∧
      ∀ X Y, (I (fullHermitianProduct X Y)).val = Glennie.jordan (I X).val (I Y).val

/-- Ternary grading theorem, all five clauses, for every ternary grading group. -/
def Statements.GradedSystem : Prop :=
  ∀ ρ : TernaryAction, IsTernaryGrading ρ →
    -- (i)
    (charSpace ρ 0 = Submodule.span ℂ {one}) ∧
    (∀ g z, z ∈ charSpace ρ g → conj z ∈ charSpace ρ (-g)) ∧
    (∀ g h z w, z ∈ charSpace ρ g → w ∈ charSpace ρ h → mul z w ∈ charSpace ρ (g + h)) ∧
    (∀ g h z w, z ∈ charSpace ρ g → w ∈ charSpace ρ h → g + h ≠ 0 → ip z w = 0) ∧
    -- (ii)
    (∀ g : Charge, g ≠ 0 →
      (∃ u ∈ charSpace ρ g, IsNormalized u) ∧
      (∀ u ∈ charSpace ρ g, IsNormalized u → ∀ v ∈ charSpace ρ g, IsNormalized v →
        ∃ a : ZMod 3, v = chargePhase a • u) ∧
      (∀ u ∈ charSpace ρ g, IsNormalized u →
        ∃ p : Fin 3 → Glennie.Albert, IsFrameOf u p ∧ contrast p = u ∧
          nativeFramePlane p = gradedPlane ρ g ∧ gradedPlaneJ ρ g ≤ Glennie.traceLinear.ker)) ∧
    -- (iii)
    (∀ (u : Charge → JC) (P : Charge → Fin 3 → Glennie.Albert),
      (∀ g, g ≠ 0 → u g ∈ charSpace ρ g ∧ IsNormalized (u g) ∧ IsFrameOf (u g) (P g)) →
      ∀ g h, g ≠ 0 → h ≠ 0 → h ≠ g → h ≠ -g → ∀ a b, Glennie.inner (P g a) (P h b) = 1 / 3) ∧
    (⨆ p : SignedPlaneIndex, pointPlane ρ p) = ⊤ ∧
    -- (iv)
    (∀ p q r r' : SignedPlaneIndex, p ≠ q → r ≠ r' → r ≠ p → r ≠ q → r' ≠ p → r' ≠ q →
      signedCollinear p q r → signedCollinear p q r' →
      mixedProductSpace nativeEqualCubic (pointPlane ρ p) (pointPlane ρ q) =
        pointPlane ρ r ⊔ pointPlane ρ r') ∧
    (∀ p q r : SignedPlaneIndex, p ≠ q → p ≠ r → q ≠ r →
      shareOfThreePlanes nativeEqualCubic (pointPlane ρ p) (pointPlane ρ q) (pointPlane ρ r) =
        if signedCollinear p q r then 1 else 0) ∧
    -- (v)
    (∀ l : SignedPlaneIndex,
      (∀ x y, x ∈ lineAlgebraOf ρ l → y ∈ lineAlgebraOf ρ l →
        Glennie.jordan x y ∈ lineAlgebraOf ρ l) ∧
      (∃ I : FullHermitian3 ≃ₗ[ℝ] lineAlgebraOf ρ l, (I hermitianOne).val = 1 ∧
        ∀ X Y, (I (fullHermitianProduct X Y)).val = Glennie.jordan (I X).val (I Y).val) ∧
      (∀ p : SignedPlaneIndex, signedPointOnLine p l → ∀ u ∈ charSpace ρ p.val.val,
        IsNormalized u → ∀ P, IsFrameOf u P → ∀ a, P a ∈ lineAlgebraOf ρ l) ∧
      IsClosedPiece nativeEqualCubic (lineTracelessOf ρ l)) ∧
    (∀ p q : SignedPlaneIndex, ∃ l, signedPointOnLine p l ∧ signedPointOnLine q l)

/-- Complex phases of graded plane coefficients. A choice of complex coordinates on the thirteen planes of the graded system is
a family of real-linear maps `ψ_p : ℂ → P_p` (the point of `P_p` with coordinate `ζ_p`) with
`‖X‖² = Σ_p |ζ_p|²` for `X = Σ_p ψ_p(ζ_p)` and `W = √6 d(X,X,X) = Re ζ_p³` on each plane. The term of
`W` on three distinct planes is the real trilinear form `6√6 d(ψ_p ζ_p, ψ_q ζ_q, ψ_r ζ_r)`; written
as a polynomial in the `ζ`'s and their conjugates its coefficients come in conjugate pairs, so all of
them are real exactly when the term is unchanged under conjugating all three coordinates. -/
def Statements.NoRealPlaneCoordinates : Prop :=
  ∀ ρ : TernaryAction, IsTernaryGrading ρ →
    ∀ ψ : SignedPlaneIndex → (ℂ →ₗ[ℝ] NativeTraceless),
      (∀ p ζ, ψ p ζ ∈ pointPlane ρ p) →
      (∀ ζ : SignedPlaneIndex → ℂ, ‖∑ p, ψ p (ζ p)‖ ^ 2 = ∑ p, ‖ζ p‖ ^ 2) →
      (∀ p ζ, Real.sqrt 6 * nativeEqualCubic.apply (ψ p ζ) (ψ p ζ) (ψ p ζ) = (ζ ^ 3).re) →
      ¬ (∀ p q r : SignedPlaneIndex, p ≠ q → p ≠ r → q ≠ r → ∀ ζ₁ ζ₂ ζ₃ : ℂ,
          nativeEqualCubic.apply (ψ p (star ζ₁)) (ψ q (star ζ₂)) (ψ r (star ζ₃)) =
            nativeEqualCubic.apply (ψ p ζ₁) (ψ q ζ₂) (ψ r ζ₃))

end

end ThirteenPlanes.AlbertGrading
