module

public import ThirteenPlanes.AlbertGrading.Grading.Cubic
public import ThirteenPlanes.AlbertGrading.Tits.Statements

@[expose] public section

/-! # Target for graded cubic expansion, every clause (Section 5)

`Targets.ThirteenPlaneCubicFull` is the grading model's `Targets.ThirteenPlaneCubic` (the phases
`⟨u_g∘u_h,u_k⟩ ∈ -(3/2)μ₃`, their independence of the representative, and display `(thirteen-field polynomial)`, for
every ternary grading group of the native Albert algebra) together with the last sentence of the
statement: "For the group of Lemma 5-tits, `φ_{ghk} = [v,w](l−k')` for `g = (v,k')`, `h = (w,l)`."

That sentence is stated on the first Tits model's carriers: `J_T` is `Tits.CompactTits` with product
`CompactTits.product`, `J_T ⊗ ℂ` is `FirstTits ℂ` with the printed product `paperProduct` and the
complex bilinear trace form `titsTraceForm` (`T`), `σ` is `compactInvolution`, and the elements
`u_g = ι_k(D_v)` of the first-Tits grading and Weyl basis (ii) are `titsBasis g`. The clause says: (0) the `u_g` span the
character spaces of the group generated by `Ad_Z`, `Ad_{X⁻¹}`, `φ` (so they are the `u_g` "as in
ternary grading theorem" for that group); (1) they are normalized, `u∘u = σu`, `u∘σu = e`; (2) for independent
`g = (v,k')`, `h = (w,l)`, `T(u_g∘u_h, u_{-(g+h)}) = -(3/2) ω^{[v,w](l−k')}`; (3) with
`X = (1/√6) Σ_p (ζ_p u_{g_p} + ζ̄_p u_{-g_p})` in `J_T`, the cubic `W = √6 T(X∘X, X)` is
`Σ_p Re ζ_p³ − 3 Σ_{52 triples} Re(ω^{[v,w](l−k')} ζ_g ζ_h ζ_k)`, the summand being the same at
every zero-sum representative. -/

open AlbertLean.Generic.C1Coordinates

namespace ThirteenPlanes.AlbertGrading

open Grading Tits

noncomputable section

namespace Cubic

/-- `[v,w](l−k')` for `g = (v,k')`, `h = (w,l)`, read off the first two entries of a triple. -/
def titsPhase (x : NonzeroCharge × NonzeroCharge × NonzeroCharge) : ZMod 3 :=
  symplecticBracket (x.1.val 0, x.1.val 1) (x.2.1.val 0, x.2.1.val 1) * (x.2.1.val 2 - x.1.val 2)

/-- `Re(ω^{[v,w](l−k')} ζ_g ζ_h ζ_k)`. -/
def titsTerm (sgn : SignedPlaneIndex → Bool) (ζ : SignedPlaneIndex → ℂ)
    (x : NonzeroCharge × NonzeroCharge × NonzeroCharge) : ℝ :=
  (chargePhase (titsPhase x) * gradeCoord sgn ζ x.1 * gradeCoord sgn ζ x.2.1 *
    gradeCoord sgn ζ x.2.2).re

open Classical in
/-- The summand of a collinear triple at a chosen representative. -/
def titsValue (sgn : SignedPlaneIndex → Bool) (ζ : SignedPlaneIndex → ℂ)
    (t : Finset SignedPlaneIndex) : ℝ :=
  if h : (tripleReps t).Nonempty then titsTerm sgn ζ h.some else 0

end Cubic

open Cubic in
/-- Graded cubic expansion, every clause, including the exponents for the group of the first-Tits grading and Weyl basis. -/
def Statements.ThirteenPlaneCubicFull : Prop :=
  Statements.ThirteenPlaneCubic ∧
  -- (0) the `u_g` of the first-Tits grading and Weyl basis are the character lines of its group
  (∀ fZ fX fφ : CompactTits ≃ₗ[ℝ] CompactTits,
    (∀ x, CompactTits.coordinates (fZ x) = adMap clockMatrix (CompactTits.coordinates x)) →
    (∀ x, CompactTits.coordinates (fX x) = adMap shiftMatrix⁻¹ (CompactTits.coordinates x)) →
    (∀ x, CompactTits.coordinates (fφ x) = phiMap (CompactTits.coordinates x)) →
    IsTernaryGradingGroup (Subgroup.closure {fZ, fX, fφ}) ∧
    ∀ g : Charge, ∃ χ : Subgroup.closure ({fZ, fX, fφ} : Set (CompactTits ≃ₗ[ℝ] CompactTits)) →* ℂˣ,
      characterSpace _ χ = (Submodule.span ℂ {titsBasis g} : Set (FirstTits ℂ))) ∧
  -- (1) normalization
  (∀ g : Charge, g ≠ 0 →
    firstTitsJordanProduct (titsBasis g) (titsBasis g) = compactInvolution (titsBasis g) ∧
    firstTitsJordanProduct (titsBasis g) (compactInvolution (titsBasis g)) = firstTitsOne) ∧
  -- (2) the phases
  (∀ (v w : WeylLabel) (k l : ZMod 3), ¬ F3Dependent (chargeFrom v k) (chargeFrom w l) →
    titsTraceForm (firstTitsJordanProduct (titsBasis (chargeFrom v k)) (titsBasis (chargeFrom w l)))
        (titsBasis (-(chargeFrom v k + chargeFrom w l))) =
      -(3 / 2 : ℂ) * chargePhase (symplecticBracket v w * (l - k))) ∧
  -- (3) display `(thirteen-field polynomial)` in `J_T`
  (∀ (sgn : SignedPlaneIndex → Bool) (ζ : SignedPlaneIndex → ℂ) (X : CompactTits),
    CompactTits.coordinates X = ((Real.sqrt 6)⁻¹ : ℂ) •
      ∑ p, (ζ p • titsBasis (signedGrade p (sgn p)).val +
        star (ζ p) • titsBasis (-(signedGrade p (sgn p)).val)) →
    (∀ t ∈ signedCollinearTriples, ∀ x ∈ tripleReps t, titsTerm sgn ζ x = titsValue sgn ζ t) ∧
    Real.sqrt 6 * (titsTraceForm (CompactTits.coordinates (CompactTits.product X X))
        (CompactTits.coordinates X)).re =
      ∑ p, (ζ p ^ 3).re - 3 * ∑ t ∈ signedCollinearTriples, titsValue sgn ζ t)

end

end ThirteenPlanes.AlbertGrading
