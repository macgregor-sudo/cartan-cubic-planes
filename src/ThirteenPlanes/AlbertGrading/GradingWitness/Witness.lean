module

public import ThirteenPlanes.AlbertGrading.GradingWitness.Statements
public import ThirteenPlanes.AlbertGrading.GradingWitness.Coordinates
public import ThirteenPlanes.AlbertGrading.Grading.GradedSystem
public import ThirteenPlanes.AlbertGrading.Grading.CubicPhaseCoordinates

@[expose] public section

/-! The reference action is a ternary grading.

The action `Graded.nativeGradingHom` is injective and preserves the Jordan product.
Each complex character space is the line of its reference basis vector. -/

namespace ThirteenPlanes.AlbertGrading

open Grading ThirteenPlanes.Graded

theorem referenceTernaryGrading : Statements.ReferenceTernaryGrading where
  injective := nativeGradingHom_injective
  automorphism s x y := nativeCharacterAction_product (Multiplicative.toAdd s) x y
  lineDim := GradingWitness.charSpace_native_finrank

theorem ternaryGradingExists : Statements.TernaryGradingExists :=
  ⟨nativeGradingHom, referenceTernaryGrading⟩

/-- Ternary grading theorem for the reference grading, under qutrit generated by two planes (i). -/
theorem gradedSystemNative (hQ : FrameProperties.QutritGeneration) : Statements.GradedSystemNative :=
  gradedSystem hQ nativeGradingHom referenceTernaryGrading

/-- Complex phases of graded plane coefficients for the reference grading. -/
theorem noRealPlaneCoordinatesNative : Statements.NoRealPlaneCoordinatesNative :=
  noRealPlaneCoordinates nativeGradingHom referenceTernaryGrading

end ThirteenPlanes.AlbertGrading
