module

public import ThirteenPlanes.AlbertGrading.Generation.Generation
public import ThirteenPlanes.AlbertGrading.Grading.Statements

@[expose] public section

/-! Two unbiased Albert frames generate a complex Hermitian qutrit.

The trace-preserving identification in `generationTwo` gives `Section3.QutritGeneration`.
The proof identifies the generated unital subalgebras and the two realizations of complex
Hermitian matrices. -/

noncomputable section

namespace ThirteenPlanes.AlbertGrading.Transport

open ThirteenPlanes.Graded

/-- The two definitions of the unital Jordan subalgebra generated by a set agree. -/
theorem generatedSubalgebra_eq_generated (X : Set Glennie.Albert) :
    Grading.generatedSubalgebra X = generated X := by
  unfold Grading.generatedSubalgebra generated
  congr 1
  ext C
  constructor
  · rintro ⟨h1, hX, hc⟩
    exact ⟨hX, h1, fun x hx y hy => hc x y hx hy⟩
  · rintro ⟨hX, h1, hc⟩
    exact ⟨h1, hX, fun x y hx hy => hc x hx y hy⟩

/-- The accepted Hermitian carrier `FullHermitian3` and Generation's `ComplexHermitian3`
(`selfAdjoint`) have the same elements; the identity on matrices is a real-linear equivalence. -/
def hermitianEquiv : FullHermitian3 ≃ₗ[ℝ] ComplexHermitian3 where
  toFun x := ⟨x.val, x.property⟩
  invFun y := ⟨y.val, y.property⟩
  map_add' _ _ := rfl
  map_smul' _ _ := rfl
  left_inv _ := rfl
  right_inv _ := rfl

@[simp] theorem hermitianEquiv_val (x : FullHermitian3) :
    ((hermitianEquiv x : ComplexHermitian3) : Matrix (Fin 3) (Fin 3) ℂ) = x.val := rfl

/-- The qutrit generation assertion follows from the generation by triples of closed planes (i). -/
theorem qutritGeneration : FrameProperties.QutritGeneration := by
  intro F G hF hG hFG
  obtain ⟨⟨φ, hinj, hrange, hone, hmul, -⟩, -⟩ := generationTwo F G hF hG hFG
  have hS : LinearMap.range φ =
      Grading.generatedSubalgebra (Set.range F ∪ Set.range G) := by
    rw [hrange, generatedSubalgebra_eq_generated]
  let I : FullHermitian3 ≃ₗ[ℝ] Grading.generatedSubalgebra (Set.range F ∪ Set.range G) :=
    (hermitianEquiv.trans (LinearEquiv.ofInjective φ hinj)).trans (LinearEquiv.ofEq _ _ hS)
  have hI (X : FullHermitian3) : (I X).val = φ (hermitianEquiv X) := rfl
  refine ⟨I, ?_, ?_⟩
  · rw [hI]
    have : hermitianEquiv Grading.hermitianOne = 1 := rfl
    rw [this, hone]
  · intro X Y
    rw [hI, hI, hI]
    apply hmul
    simp only [hermitianEquiv_val, fullHermitianProduct, ThirteenPlanes.symmetricMatrixProduct]
    rw [← Complex.coe_smul]
    norm_num

end ThirteenPlanes.AlbertGrading.Transport
