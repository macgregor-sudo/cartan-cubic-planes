module

public import ThirteenPlanes.AlbertGrading.Contrast.Statements
public import ThirteenPlanes.AlbertGrading.Generation.Statements
public import ThirteenPlanes.AlbertGrading.Recognition.Main
public import ThirteenPlanes.AlbertGrading.Transport.Qutrit
public import ThirteenPlanes.FieldDefect.Statements

@[expose] public section

/-! Geometric inputs to the graded Albert results.

`FrameProperties.QutritFourFrames` is the simultaneous unitary identification of four unbiased
complex frames with the Weyl frames, up to frame and outcome permutations. It is used for
the contrast table. `Section3.ClosedPlaneHasFrame` identifies each closed Albert trace plane
with a frame plane. `Section3.NormalFormOctonion` puts two unbiased Albert frames into
diagonal and Fourier form over a common complex octonion slice.

`Section3.QutritGeneration` identifies the unital algebra generated by two unbiased Albert
frames with the complex Hermitian qutrit. The field-count input `Section6.FieldsCount` for
the defect theorem restricts radially symmetric gradient length to one, four or thirteen
fields. -/

noncomputable section

namespace ThirteenPlanes.AlbertGrading.Transport

/-- Geometric hypotheses for the contrast, generation and recognition results. -/
def FramePropertyHypotheses : Prop :=
  FrameProperties.QutritFourFrames ∧ FrameProperties.ClosedPlaneHasFrame ∧ FrameProperties.NormalFormOctonion

/-- All open hypotheses of the block's endpoints, including the Section 6 count clause. -/
def FrameAndFieldHypotheses : Prop := FramePropertyHypotheses ∧ FieldClassification.FieldsCount

/-- `Section3.QutritGeneration` is not open: it is discharged by the generation by triples of closed planes (i). -/
theorem qutritGeneration_fromFramePairs : FrameProperties.QutritGeneration := qutritGeneration

/-- The normal form implies the pair normalization used by the recognition of systems with 52 positive shares. -/
theorem pairNormalization_fromOctonionNormalForm (h : FrameProperties.NormalFormOctonion) :
    OrbitHypotheses.PairNormalization := pairNormalization_of_normalForm h

end ThirteenPlanes.AlbertGrading.Transport
