module

public import ThirteenPlanes.Cartan.DerivationGradingCore
public import Mathlib.LinearAlgebra.FiniteDimensional.Lemmas
public import Mathlib.Algebra.Field.ZMod

@[expose] public section

set_option backward.privateInPublic true

/-! Generation by a pair of independent directions and by a basis triple. -/

open scoped BigOperators
open Module

namespace ThirteenPlanes.Cartan.NormalizedTernaryBasis

noncomputable section

variable {A : Type*} [AddCommGroup A] [Module ℂ A]
variable (M : NormalizedTernaryBasis A)

/-- Two directions in the ternary charge space are linearly independent. -/
structure IndependentDirections (g h : Charge) : Prop where
  left_ne_zero : g ≠ 0
  right_not_multiple : ∀ a : ZMod 3, h ≠ a • g

namespace IndependentDirections

theorem right_ne_zero {g h : Charge} (indep : IndependentDirections g h) : h ≠ 0 := by
  simpa only [zero_smul] using indep.right_not_multiple 0

theorem right_ne_left {g h : Charge} (indep : IndependentDirections g h) : h ≠ g := by
  simpa only [one_smul] using indep.right_not_multiple 1

theorem right_ne_neg_left {g h : Charge} (indep : IndependentDirections g h) : h ≠ -g := by
  simpa only [neg_smul, one_smul] using indep.right_not_multiple (-1)

theorem smul {g h : Charge} (indep : IndependentDirections g h)
    {a b : ZMod 3} (ha : a ≠ 0) (hb : b ≠ 0) :
    IndependentDirections (a • g) (b • h) := by
  refine ⟨smul_ne_zero ha indep.left_ne_zero, fun c he => ?_⟩
  apply indep.right_not_multiple (b⁻¹ * (c * a))
  have hh := congrArg (fun z : Charge => b⁻¹ • z) he
  simpa only [smul_smul, inv_mul_cancel₀ hb, one_smul] using hh

end IndependentDirections

/-- Closure of a complex subspace under the actual Jordan product. -/
def ProductClosed (S : Submodule ℂ A) : Prop :=
  ∀ {x y}, x ∈ S → y ∈ S → M.product x y ∈ S

private theorem basis_multiple_mem {S : Submodule ℂ A} (hS : M.ProductClosed S)
    (hunit : M.basis 0 ∈ S) {g : Charge} (hg : M.basis g ∈ S) (a : ZMod 3) :
    M.basis (a • g) ∈ S := by
  have hcases : ∀ x : ZMod 3, x = 0 ∨ x = 1 ∨ x = -1 := by decide
  rcases hcases a with rfl | rfl | rfl
  · simpa only [zero_smul] using hunit
  · simpa only [one_smul] using hg
  · simp only [neg_smul, one_smul]
    by_cases hzero : g = 0
    · simpa only [hzero, neg_zero] using hunit
    · rw [← M.square g hzero]
      exact hS hg hg

private theorem basis_add_mem_of_independent {S : Submodule ℂ A}
    (hS : M.ProductClosed S) {g h : Charge} (indep : IndependentDirections g h)
    (hg : M.basis g ∈ S) (hh : M.basis h ∈ S) :
    M.basis (g + h) ∈ S := by
  obtain ⟨t, ht⟩ := M.homogeneous_product g h
  have hne : t ≠ 0 := by
    intro hz
    rw [hz, zero_smul] at ht
    exact M.independent_product g h indep.left_ne_zero indep.right_ne_zero
      indep.right_ne_left indep.right_ne_neg_left ht
  have hmem := S.smul_mem t⁻¹ (hS hg hh)
  rwa [ht, smul_smul, inv_mul_cancel₀ hne, one_smul] at hmem

/-- Every grade in the projective line through two independent directions is
generated by the unit and the two actual homogeneous basis vectors. -/
theorem generated_line_basis_mem {S : Submodule ℂ A} (hS : M.ProductClosed S)
    (hunit : M.basis 0 ∈ S) {g h : Charge} (indep : IndependentDirections g h)
    (hg : M.basis g ∈ S) (hh : M.basis h ∈ S) (a b : ZMod 3) :
    M.basis (a • g + b • h) ∈ S := by
  by_cases ha : a = 0
  · simpa only [ha, zero_smul, zero_add] using M.basis_multiple_mem hS hunit hh b
  by_cases hb : b = 0
  · simpa only [hb, zero_smul, add_zero] using M.basis_multiple_mem hS hunit hg a
  exact M.basis_add_mem_of_independent hS (indep.smul ha hb)
    (M.basis_multiple_mem hS hunit hg a) (M.basis_multiple_mem hS hunit hh b)

/-- Two distinct members of a charge-space basis are independent directions. -/
theorem independentDirections_basis (B : Basis (Fin 3) (ZMod 3) Charge) {i j : Fin 3}
    (hij : i ≠ j) : IndependentDirections (B i) (B j) := by
  refine ⟨B.ne_zero i, fun a h => ?_⟩
  have he := congrArg (B.coord j) h
  have hj : j ≠ i := hij.symm
  simp [Basis.coord_apply, Basis.repr_self, hj] at he

/-- Three homogeneous vectors indexed by a basis of the charge space generate the entire algebra. -/
theorem generated_basis_eq_top (B : Basis (Fin 3) (ZMod 3) Charge)
    {S : Submodule ℂ A} (hS : M.ProductClosed S) (hunit : M.basis 0 ∈ S)
    (hB : ∀ i, M.basis (B i) ∈ S) : S = ⊤ := by
  apply top_unique
  rw [← M.basis.span_eq]
  refine Submodule.span_le.mpr ?_
  rintro _ ⟨g, rfl⟩
  change M.basis g ∈ S
  let a := B.repr g 0
  let b := B.repr g 1
  let c := B.repr g 2
  let w := a • B 0 + b • B 1
  have hrep : w + c • B 2 = g := by
    simpa only [Fin.sum_univ_three, w, a, b, c] using B.sum_repr g
  rw [← hrep]
  have hw : M.basis w ∈ S :=
    M.generated_line_basis_mem hS hunit (independentDirections_basis B (by decide : (0 : Fin 3) ≠ 1))
      (hB 0) (hB 1) a b
  have hc : M.basis (c • B 2) ∈ S := M.basis_multiple_mem hS hunit (hB 2) c
  by_cases hw0 : w = 0
  · simpa only [hw0, zero_add] using hc
  by_cases hc0 : c = 0
  · simpa only [hc0, zero_smul, add_zero] using hw
  have hind : IndependentDirections w (c • B 2) := by
    refine ⟨hw0, fun t h => ?_⟩
    have he := congrArg (B.coord 2) h
    have hz : c = 0 := by
      simpa [w, Basis.coord_apply, Basis.repr_self] using he
    exact hc0 hz
  exact M.basis_add_mem_of_independent hS hind hw hc

theorem derivation_ker_productClosed {D : Module.End ℂ A} (hd : M.IsDerivation D) :
    M.ProductClosed D.ker := by
  intro x y hx hy
  rw [LinearMap.mem_ker] at hx hy ⊢
  rw [hd, hx, hy, map_zero, LinearMap.zero_apply, map_zero, add_zero]

/-- A grade-γ derivation vanishes on a projective line through γ exactly when
its coefficient on the other generator of the line vanishes. -/
theorem derivationGrade_vanishes_line_iff {D : Module.End ℂ A} {γ g : Charge}
    (hD : D ∈ M.derivationGrade γ) (indep : IndependentDirections γ g) :
    (∀ a b : ZMod 3, D (M.basis (a • γ + b • g)) = 0) ↔
      M.gradeCoefficient γ g D = 0 := by
  constructor
  · intro h
    have hz : D (M.basis g) = 0 := by simpa only [zero_smul, one_smul, zero_add] using h 0 1
    have hcoef := M.derivationGrade_apply hD g
    rw [hz, eq_comm, smul_eq_zero] at hcoef
    exact hcoef.resolve_right (M.basis.ne_zero _)
  · intro h a b
    have hg : D (M.basis g) = 0 := by rw [M.derivationGrade_apply hD, h, zero_smul]
    have hk := M.derivation_kills_unit (M.mem_derivationGrade.mp hD).1
    have hγ := (M.derivationGrade_kills_directions indep.left_ne_zero hD).1
    exact M.generated_line_basis_mem (M.derivation_ker_productClosed (M.mem_derivationGrade.mp hD).1)
      hk indep hγ hg a b

/-- Two coefficients of the homogeneous derivation on a charge basis that starts at γ. -/
def gradeEvaluation (γ : Charge) (B : Basis (Fin 3) (ZMod 3) Charge) :
    M.derivationGrade γ →ₗ[ℂ] (ℂ × ℂ) :=
  ((M.gradeCoefficient γ (B 1)).prod (M.gradeCoefficient γ (B 2))).comp
    (M.derivationGrade γ).subtype

/-- Degree-γ derivations are determined by their coefficients on the other two charge vectors. -/
theorem gradeEvaluation_injective {γ : Charge} (B : Basis (Fin 3) (ZMod 3) Charge)
    (hB : B 0 = γ) : Function.Injective (M.gradeEvaluation γ B) := by
  intro D E h
  apply Subtype.ext
  let T : M.derivationGrade γ := D - E
  have hT : M.gradeEvaluation γ B T = 0 := by
    change M.gradeEvaluation γ B (D - E) = 0
    rw [map_sub, h, sub_self]
  have hunit := M.derivation_kills_unit (M.mem_derivationGrade.mp T.property).1
  have hγ : γ ≠ 0 := hB ▸ B.ne_zero 0
  have hγT := (M.derivationGrade_kills_directions hγ T.property).1
  have hBT (i : Fin 3) : T.val (M.basis (B i)) = 0 := by
    fin_cases i
    · change T.val (M.basis (B 0)) = 0
      exact hB.symm ▸ hγT
    · have hc := congrArg Prod.fst hT
      change M.gradeCoefficient γ (B 1) T.val = 0 at hc
      change T.val (M.basis (B 1)) = _
      rw [M.derivationGrade_apply T.property, hc, zero_smul]
    · have hc := congrArg Prod.snd hT
      change M.gradeCoefficient γ (B 2) T.val = 0 at hc
      change T.val (M.basis (B 2)) = _
      rw [M.derivationGrade_apply T.property, hc, zero_smul]
  have hk := M.generated_basis_eq_top B
    (M.derivation_ker_productClosed (M.mem_derivationGrade.mp T.property).1) hunit hBT
  have hz := LinearMap.ker_eq_top.mp hk
  exact sub_eq_zero.mp hz

/-- The coefficient map is bijective as soon as the grade has dimension two. -/
theorem gradeEvaluation_bijective {γ : Charge} (B : Basis (Fin 3) (ZMod 3) Charge)
    (hB : B 0 = γ) (hfin : Module.finrank ℂ (M.derivationGrade γ) = 2)
    [FiniteDimensional ℂ A] : Function.Bijective (M.gradeEvaluation γ B) := by
  have hEq : Module.finrank ℂ (M.derivationGrade γ) = Module.finrank ℂ (ℂ × ℂ) := by
    rw [hfin, Module.finrank_prod, Module.finrank_self]
  have hInjective := M.gradeEvaluation_injective B hB
  exact ⟨hInjective, (LinearMap.injective_iff_surjective_of_finrank_eq_finrank hEq).mp hInjective⟩

end
end ThirteenPlanes.Cartan.NormalizedTernaryBasis
