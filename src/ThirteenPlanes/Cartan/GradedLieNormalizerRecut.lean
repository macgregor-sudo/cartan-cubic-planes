module

public import ThirteenPlanes.Cartan.GradedLieNormalizerLine
public import ThirteenPlanes.Cartan.GradedLineCartans

@[expose] public section

/-! The actual projective Cartan line sum is normalized by the line exponential. -/

namespace ThirteenPlanes.Cartan

open AlbertGrading.Grading

noncomputable section

attribute [local instance 100] LieRing.ofAssociativeRing

/-- The compact exponential generated by a line derivation normalizes the sum of the
four real Cartans on the given projective line. -/
theorem nativeAlbertExp_normalizes_gradedCartanLine {ρ : TernaryAction} (hρ : IsTernaryGrading ρ)
    (l : SignedPlaneIndex) (D : NativeAlbertDerivations)
    (hD : D.val ∈ (albertGradingBasis hρ).realLineDerivations (signedProjectiveLine l)) :
    let T := ⨆ p : {p : SignedPlaneIndex // signedPointOnLine p l},
      (albertGradingRealCartan hρ p.val).toSubmodule
    let k := albertExpCompactAutomorphism (nativeAlbertDerivationSkewEquiv D)
    T.map (nativeAlbertLieAction k).toLinearEquiv.toLinearMap = T := by
  dsimp only
  rw [iSup_realCartan_eq_comap_realLineDerivations hρ l]
  exact nativeAlbertExp_normalizes_realLineDerivations hρ l D hD

/-- The same compact exponential normalizes the traceless action of the actual line derivations. -/
theorem albertExp_normalizes_traceGradingLine {ρ : TernaryAction} (hρ : IsTernaryGrading ρ)
    (l : SignedPlaneIndex) (D : NativeAlbertDerivations)
    (hD : D.val ∈ (albertGradingBasis hρ).realLineDerivations (signedProjectiveLine l)) :
    let S := (albertGradingBasis hρ).realLineDerivations (signedProjectiveLine l)
    let T := (albertSkewDerivationsIn S).map albertJordan.restrictDerivation
    let k := albertExpCompactAutomorphism (nativeAlbertDerivationSkewEquiv D)
    T.map (conjugateSkew ((albertJordanAction k).traceAction albertJordan)).toLinearMap = T :=
  albertExpCompactAutomorphism_normalizes_trace (nativeAlbertDerivationSkewEquiv D)
    ((albertGradingBasis hρ).realLineDerivations (signedProjectiveLine l))
    (fun _ hX => (albertGradingBasis hρ).realLineDerivations_bracket (signedProjectiveLine l) hD hX)

end

end ThirteenPlanes.Cartan
