module

public import ThirteenPlanes.Qutrit.ClosedPair
public import ThirteenPlanes.Qutrit.ComplexUnit
public import ThirteenPlanes.Peirce.SlotClosedPlaneIdentification

@[expose] public section

set_option backward.privateInPublic true

/-! The full unital Jordan algebra generated by two orthogonal frame planes. -/

open scoped RealInnerProductSpace

namespace ThirteenPlanes.JordanFrames

noncomputable section

open RoundCubics Peirce

variable {V E : Type*} [NormedAddCommGroup V] [InnerProductSpace ℝ V]
  [FiniteDimensional ℝ V] [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  {h : SymmetricCubic V} {g : SymmetricCubic E} {e : E} {J : V →ₗᵢ[ℝ] E}
  {U Y : Submodule ℝ V}

/-- The intersection of unital Jordan subalgebras containing both actual frames. -/
def framePairGenerated (g : SymmetricCubic E) (e : E) (p q : Fin 3 → E) : Submodule ℝ E :=
  sInf {B : Submodule ℝ E | e ∈ B ∧ IsClosedPiece g B ∧ (∀ i, p i ∈ B) ∧ ∀ i, q i ∈ B}

private def traceUnitJoin (J : V →ₗᵢ[ℝ] E) (e : E) (S : Submodule ℝ V) :
    (S × ℝ) →ₗ[ℝ] E where
  toFun x := J (x.1 : V) + x.2 • e
  map_add' x y := by simp only [Prod.fst_add, Prod.snd_add, Submodule.coe_add, map_add, add_smul]; abel
  map_smul' r x := by
    change J (r • (x.1 : V)) + (r * x.2) • e = r • (J (x.1 : V) + x.2 • e)
    rw [map_smul, smul_add, smul_smul]

omit [FiniteDimensional ℝ V] in
private theorem traceUnitJoin_inner (orthUnit : ∀ x, ⟪e, J x⟫ = 0) (rank : ⟪e, e⟫ = 3)
    {S : Submodule ℝ V} (x : S × ℝ) :
    ⟪e, traceUnitJoin J e S x⟫ = 3 * x.2 := by
  change ⟪e, J (x.1 : V) + x.2 • e⟫ = _
  rw [inner_add_right, real_inner_smul_right, orthUnit, rank, zero_add, mul_comm]

omit [FiniteDimensional ℝ V] in
private theorem traceUnitJoin_injective (orthUnit : ∀ x, ⟪e, J x⟫ = 0) (rank : ⟪e, e⟫ = 3)
    {S : Submodule ℝ V} :
    Function.Injective (traceUnitJoin J e S) := by
  intro x y hx
  have htrace := congrArg (inner ℝ e) hx
  rw [traceUnitJoin_inner orthUnit rank, traceUnitJoin_inner orthUnit rank] at htrace
  have hr : x.2 = y.2 := by linarith
  change J (x.1 : V) + x.2 • e = J (y.1 : V) + y.2 • e at hx
  rw [hr] at hx
  exact Prod.ext (Subtype.ext (J.injective (add_right_cancel hx))) hr

private def traceUnitProduct (closed : IsClosedPiece h S) (x y : S × ℝ) : S × ℝ :=
  (⟨h.L (x.1 : V) (y.1 : V), closed x.1.property y.1.property⟩ +
      x.2 • y.1 + y.2 • x.1, ⟪x.1, y.1⟫ / 3 + x.2 * y.2)

omit [FiniteDimensional ℝ V] in
private theorem traceUnitJoin_product (unit : ∀ x, g.L e x = x)
    (split : ∀ x y, g.L (J x) (J y) = J (h.L x y) + (⟪x, y⟫ / 3) • e)
    {S : Submodule ℝ V} (closed : IsClosedPiece h S) (x y : S × ℝ) :
    traceUnitJoin J e S (traceUnitProduct closed x y) =
      g.L (traceUnitJoin J e S x) (traceUnitJoin J e S y) := by
  have right (z : E) : g.L z e = z := (g.L_comm z e).trans (unit z)
  change J ((h.L (x.1 : V) (y.1 : V)) + x.2 • (y.1 : V) + y.2 • (x.1 : V)) +
      (⟪(x.1 : V), (y.1 : V)⟫ / 3 + x.2 * y.2) • e =
    g.L (J (x.1 : V) + x.2 • e) (J (y.1 : V) + y.2 • e)
  simp only [map_add, LinearMap.add_apply, map_smul, LinearMap.smul_apply,
    split, unit, right, smul_add, smul_smul, add_smul]
  module

omit [FiniteDimensional ℝ V] in
private theorem generated_eq_range (unit : ∀ x, g.L e x = x)
    (split : ∀ x y, g.L (J x) (J y) = J (h.L x y) + (⟪x, y⟫ / 3) • e)
    (F : CenteredTraceFrame J e U) (G : CenteredTraceFrame J e Y)
    (closure : IsClosedPiece h ((U ⊔ Y) ⊔ mixedProductSpace h U Y)) :
    framePairGenerated g e F.point G.point =
      LinearMap.range (traceUnitJoin J e ((U ⊔ Y) ⊔ mixedProductSpace h U Y)) := by
  let S := (U ⊔ Y) ⊔ mixedProductSpace h U Y
  let B := LinearMap.range (traceUnitJoin J e S)
  have uS : U ≤ S := le_sup_left.trans le_sup_left
  have yS : Y ≤ S := le_sup_right.trans le_sup_left
  have eB : e ∈ B := ⟨(0, 1), by change J 0 + (1 : ℝ) • e = e; simp⟩
  have Bcl : IsClosedPiece g B := by
    rintro _ _ ⟨x, rfl⟩ ⟨y, rfl⟩
    exact ⟨traceUnitProduct closure x y, traceUnitJoin_product unit split closure x y⟩
  have Bframe {T : Submodule ℝ V} (tS : T ≤ S) (P : CenteredTraceFrame J e T) (i : Fin 3) :
      P.point i ∈ B := by
    refine ⟨(⟨P.centered i, tS (P.centered i).property⟩, 1 / 3), ?_⟩
    change J (P.centered i : V) + (1 / 3 : ℝ) • e = P.point i
    rw [P.centered_eq, sub_add_cancel]
  apply le_antisymm
  · exact sInf_le (show e ∈ B ∧ IsClosedPiece g B ∧ (∀ i, F.point i ∈ B) ∧ (∀ i, G.point i ∈ B)
      from ⟨eB, Bcl, Bframe uS F, Bframe yS G⟩)
  · apply le_sInf
    intro T hT
    obtain ⟨eT, Tcl, FT, GT⟩ := hT
    have genPlane {P : Submodule ℝ V} (M : CenteredTraceFrame J e P)
        (MT : ∀ i, M.point i ∈ T) : P ≤ T.comap J.toLinearMap := by
      intro x hx
      let z : P := ⟨x, hx⟩
      have hrep := congrArg (fun v : P => J (v : V)) (M.reconstruction z)
      simp only [Submodule.coe_sum, Submodule.coe_smul, map_sum, map_smul, M.centered_eq] at hrep
      change J x ∈ T
      rw [← (show _ = J x from hrep)]
      exact T.sum_mem (fun i _ => T.smul_mem _ (T.sub_mem (MT i) (T.smul_mem _ eT)))
    have uT := genPlane F FT
    have yT := genPlane G GT
    have wT : mixedProductSpace h U Y ≤ T.comap J.toLinearMap := by
      rw [mixedProductSpace_eq_span]
      apply Submodule.map₂_le.mpr
      intro x hx y hy
      have hm : g.L (J x) (J y) ∈ T := Tcl (uT hx) (yT hy)
      rw [split] at hm
      change J (h.L x y) ∈ T
      simpa only [add_sub_cancel_right] using T.sub_mem hm (T.smul_mem (⟪x, y⟫ / 3) eT)
    have sT : S ≤ T.comap J.toLinearMap := sup_le (sup_le uT yT) wT
    rintro _ ⟨x, rfl⟩
    exact T.add_mem (sT x.1.property) (T.smul_mem x.2 eT)

omit [FiniteDimensional ℝ V] in
private theorem traceZero_range (orthUnit : ∀ x, ⟪e, J x⟫ = 0) (rank : ⟪e, e⟫ = 3)
    (S : Submodule ℝ V) :
    (LinearMap.range (traceUnitJoin J e S)) ⊓ (ℝ ∙ e)ᗮ = S.map J.toLinearMap := by
  apply le_antisymm
  · rintro _ ⟨⟨x, rfl⟩, hx⟩
    have h₀ := Submodule.inner_right_of_mem_orthogonal
      (Submodule.mem_span_singleton_self e) hx
    rw [traceUnitJoin_inner orthUnit rank] at h₀
    have h₂ : x.2 = 0 := by linarith
    exact ⟨x.1, x.1.property, by change J (x.1 : V) = J (x.1 : V) + x.2 • e; simp [h₂]⟩
  · rintro _ ⟨x, hx, rfl⟩
    refine ⟨⟨(⟨x, hx⟩, 0), by change J x + (0 : ℝ) • e = J x; simp⟩, ?_⟩
    apply ((ℝ ∙ e) : Submodule ℝ E).mem_orthogonal (J x) |>.mpr
    intro w hw
    obtain ⟨r, rfl⟩ := Submodule.mem_span_singleton.mp hw
    rw [real_inner_smul_left, orthUnit, mul_zero]

private theorem traceUnitProduct_complex {S : Submodule ℝ V}
    (K : S ≃ₗᵢ[ℝ] TracelessHermitian3)
    (hK : h.pullback S.subtype = matrixEqualCubic.pullback K.toLinearMap)
    (closed : IsClosedPiece h S) (u v : S × ℝ) :
    let p := traceUnitProduct closed u v
    (complexQutritJoin (K p.1, p.2)).val =
      symmetricMatrixProduct (complexQutritJoin (K u.1, u.2)).val
        (complexQutritJoin (K v.1, v.2)).val := by
  dsimp only
  have intertwine := pullback_intertwines_product (h := h.pullback S.subtype)
    (k := matrixEqualCubic) K hK u.1 v.1
  change K ((h.pullback S.subtype).L u.1 v.1) =
    TracelessHermitian3.jordan (K u.1) (K v.1) at intertwine
  have hsub : (h.pullback S.subtype).L u.1 v.1 =
      ⟨h.L (u.1 : V) (v.1 : V), closed u.1.property v.1.property⟩ :=
    Subtype.ext (closedSubspace_restriction_product closed u.1 v.1)
  rw [hsub] at intertwine
  rw [← complexQutritJoin_product]
  apply congrArg (fun p : TracelessHermitian3 × ℝ => (complexQutritJoin p).val)
  apply Prod.ext
  · simp only [traceUnitProduct, map_add, map_smul, intertwine]
  · change ⟪u.1, v.1⟫ / 3 + u.2 * v.2 = ⟪K u.1, K v.1⟫ / 3 + u.2 * v.2
    have hi := norm_add_sq_real (K u.1) (K v.1)
    rw [← K.map_add, K.norm_map, K.norm_map, K.norm_map] at hi
    have hj := norm_add_sq_real u.1 v.1
    linarith only [hi, hj]

set_option maxHeartbeats 650000 in
/-- The full algebra generated by the pair of frames. The orthogonal octet is the actual
trace-zero subspace, and the unital product is carried to the symmetrized matrix product. -/
theorem twoPlanes_generateComplexQutrit_unmarked (round : IsRound h (1 / 6))
    (unit : ∀ x, g.L e x = x) (orthUnit : ∀ x, ⟪e, J x⟫ = 0)
    (split : ∀ x y, g.L (J x) (J y) = J (h.L x y) + (⟪x, y⟫ / 3) • e)
    (F : CenteredTraceFrame J e U) (G : CenteredTraceFrame J e Y)
    (orth : U.IsOrtho Y) (closed : IsClosedPiece h U) (closed' : IsClosedPiece h Y)
    (dim : Module.finrank ℝ U = 2) (dim' : Module.finrank ℝ Y = 2) :
    let W := mixedProductSpace h U Y
    let S := (U ⊔ Y) ⊔ W
    let A := framePairGenerated g e F.point G.point
    Module.finrank ℝ W = 4 ∧ W.IsOrtho (U ⊔ Y) ∧
    (∀ (x x' : U) (y y' : Y), ⟪h.L (x : V) y, h.L (x' : V) y'⟫ =
      ((1 : ℝ) / 6 / 2) * (⟪x, x'⟫ * ⟪y, y'⟫)) ∧
    A ⊓ (ℝ ∙ e)ᗮ = S.map J.toLinearMap ∧
    ∃ (he : e ∈ A) (hc : IsClosedPiece g A) (I : A ≃ₗ[ℝ] AlbertSequential.Hermitian3),
      (I ⟨e, he⟩).val = 1 ∧
      (∀ x : A, (Matrix.trace (I x).val).re = ⟪e, (x : E)⟫) ∧
      (∀ x y : A, (I ⟨g.L (x : E) (y : E), hc x.property y.property⟩).val =
        symmetricMatrixProduct (I x).val (I y).val) := by
  dsimp only
  let S := (U ⊔ Y) ⊔ mixedProductSpace h U Y
  let A := framePairGenerated g e F.point G.point
  obtain ⟨Scl, K, hK⟩ := closedPair_complexOctet round orth closed closed' dim dim'
  have rank := F.unit_inner_self
  have eqA : A = LinearMap.range (traceUnitJoin J e S) := generated_eq_range unit split F G Scl
  let join := traceUnitJoin J e S
  let joinMap : (S × ℝ) →ₗ[ℝ] A :=
    join.codRestrict A (fun x => eqA ▸ ⟨x, rfl⟩)
  let joinA : (S × ℝ) ≃ₗ[ℝ] A := LinearEquiv.ofBijective joinMap ⟨by
    intro x y hz
    exact traceUnitJoin_injective orthUnit rank (congrArg Subtype.val hz), by
    intro x
    have hmem : (x : E) ∈ LinearMap.range join := eqA ▸ x.property
    obtain ⟨z, hz⟩ := hmem
    exact ⟨z, Subtype.ext hz⟩⟩
  have joinA_val (x : S × ℝ) : (joinA x : E) = join x := rfl
  have he : e ∈ A := eqA ▸ ⟨(0, 1), by change J 0 + (1 : ℝ) • e = e; simp⟩
  have hc : IsClosedPiece g A := by
    rw [eqA]
    rintro _ _ ⟨x, rfl⟩ ⟨y, rfl⟩
    exact ⟨traceUnitProduct Scl x y, traceUnitJoin_product unit split Scl x y⟩
  let target := (K.toLinearEquiv.prodCongr (LinearEquiv.refl ℝ ℝ)).trans complexQutritJoin
  let I := joinA.symm.trans target
  have eval (x : S × ℝ) : I (joinA x) = complexQutritJoin (K x.1, x.2) := by
    change target (joinA.symm (joinA x)) = _
    rw [LinearEquiv.symm_apply_apply]
    rfl
  have ht : A ⊓ (ℝ ∙ e)ᗮ = S.map J.toLinearMap := by
    rw [eqA]
    exact traceZero_range orthUnit rank S
  refine ⟨mixedProductSpace_finrank round orth closed closed' dim dim',
    Submodule.isOrtho_iff_le.mpr (mixedProductSpace_le_orthogonal round orth closed closed'),
    fun x x' y y' => mixedProduct_gram round orth closed closed' dim x x' y y',
    ht, he, hc, I, ?_, ?_, ?_⟩
  · have hu : joinA (0, 1) = ⟨e, he⟩ := Subtype.ext (by
      rw [joinA_val]; change J 0 + (1 : ℝ) • e = e; simp)
    rw [← hu, eval, complexQutritJoin_coe]
    simp
  · intro x
    obtain ⟨v, rfl⟩ := joinA.surjective x
    rw [eval, complexQutritJoin_trace, joinA_val, traceUnitJoin_inner orthUnit rank]
  · intro x y
    obtain ⟨u, rfl⟩ := joinA.surjective x
    obtain ⟨v, rfl⟩ := joinA.surjective y
    have hprod : joinA (traceUnitProduct Scl u v) =
        ⟨g.L (joinA u : E) (joinA v : E), hc (joinA u).property (joinA v).property⟩ := by
      apply Subtype.ext
      change join (traceUnitProduct Scl u v) = g.L (join u) (join v)
      exact traceUnitJoin_product unit split Scl u v
    rw [← hprod, eval, eval, eval]
    exact traceUnitProduct_complex K hK Scl u v

end

end ThirteenPlanes.JordanFrames
