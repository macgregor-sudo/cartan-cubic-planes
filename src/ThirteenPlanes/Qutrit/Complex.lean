module

public import ThirteenPlanes.Qutrit.Marked

@[expose] public section

set_option backward.privateInPublic true

/-! The qutrit generated by actual complex Hermitian frame idempotents. -/

open scoped RealInnerProductSpace

namespace ThirteenPlanes.JordanFrames

noncomputable section

open RoundCubics Peirce AlbertSequential

private theorem complex_unit_trace (x : FullHermitian) :
    ⟪complexUnit, x⟫ = (Matrix.trace (fullMatrix x)).re := by
  rw [fullInner_eq_tracePairing]
  change (Matrix.trace ((1 : ComplexMatrix3) * fullMatrix x)).re = _
  rw [one_mul]

private theorem complex_jordan_split (x y : TracelessHermitian3) :
    complexFullCubic.L (complexTraceInclusion x) (complexTraceInclusion y) =
      complexTraceInclusion (matrixEqualCubic.L x y) + (⟪x, y⟫ / 3) • complexUnit := by
  apply fullMatrix_injective
  rw [fullMatrix_complexFullCubic_product, map_add, map_smul]
  change symmetricMatrixProduct x.toMatrix y.toMatrix =
    (TracelessHermitian3.jordan x y).toMatrix + (⟪x, y⟫ / 3) • (1 : ComplexMatrix3)
  rw [TracelessHermitian3.toMatrix_jordan, traceFreePart,
    hermitian_trace_eq_real (symmetricMatrixProduct_hermitian x.isHermitian y.isHermitian),
    ← tracePairing_eq_re_trace_jordan, ← TracelessHermitian3.inner_eq_tracePairing]
  change _ = _ - (↑⟪x, y⟫ / 3 : ℂ) • (1 : ComplexMatrix3) +
    ((↑(⟪x, y⟫ / 3) : ℂ) • (1 : ComplexMatrix3))
  rw [Complex.ofReal_div, Complex.ofReal_ofNat, sub_add_cancel]

private theorem complex_traceJordanFrame (F : ComplexTraceFrame3) :
    TraceJordanFrame complexFullCubic complexUnit (complexFrameData F).point := by
  refine ⟨?_, ?_, ?_, (complexFrameData F).point_sum⟩
  · intro i
    rw [complex_unit_trace]
    change (Matrix.trace (fullMatrix (ofFullMatrix (F.point i) (F.hermitian i)))).re = 1
    rw [fullMatrix_ofFullMatrix, F.trace_one, Complex.one_re]
  · intro i
    apply fullMatrix_injective
    rw [fullMatrix_complexFullCubic_product]
    change symmetricMatrixProduct (fullMatrix (ofFullMatrix (F.point i) (F.hermitian i)))
      (fullMatrix (ofFullMatrix (F.point i) (F.hermitian i))) =
        fullMatrix (ofFullMatrix (F.point i) (F.hermitian i))
    simpa using F.jordan_point i i
  · intro i j hij
    apply fullMatrix_injective
    rw [fullMatrix_complexFullCubic_product, map_zero]
    change symmetricMatrixProduct (fullMatrix (ofFullMatrix (F.point i) (F.hermitian i)))
      (fullMatrix (ofFullMatrix (F.point j) (F.hermitian j))) = 0
    simpa only [fullMatrix_ofFullMatrix, ite_eq_right hij] using F.jordan_point i j

/-- Proposition qutrit on the literal complex Hermitian trace carrier. -/
theorem complex_framePair_generated_qutrit (F G : ComplexTraceFrame3)
    (unbiased : ∀ i j, tracePairing (F.point i) (G.point j) = 1 / 3) :
    let p := (complexFrameData F).point
    let q := (complexFrameData G).point
    let U := F.plane
    let Y := G.plane
    let W := mixedProductSpace matrixEqualCubic U Y
    let S := (U ⊔ Y) ⊔ W
    let A := framePairGenerated complexFullCubic complexUnit p q
    Module.finrank ℝ W = 4 ∧ W.IsOrtho (U ⊔ Y) ∧
    (∀ (x x' : U) (y y' : Y), ⟪matrixEqualCubic.L (x : TracelessHermitian3) y,
      matrixEqualCubic.L (x' : TracelessHermitian3) y'⟫ = ((1 : ℝ) / 6 / 2) *
        (⟪(x : TracelessHermitian3), (x' : TracelessHermitian3)⟫ *
          ⟪(y : TracelessHermitian3), (y' : TracelessHermitian3)⟫)) ∧
    A ⊓ (ℝ ∙ complexUnit)ᗮ = S.map complexTraceInclusion.toLinearMap ∧
    ∃ (he : complexUnit ∈ A) (hc : IsClosedPiece complexFullCubic A) (I : A ≃ₗ[ℝ] Hermitian3)
        (σ τ : Equiv.Perm (Fin 3)),
      (I ⟨complexUnit, he⟩).val = 1 ∧
      (∀ x : A, (Matrix.trace (I x).val).re = (Matrix.trace (fullMatrix (x : FullHermitian))).re) ∧
      (∀ x y : A, (I ⟨complexFullCubic.L (x : FullHermitian) (y : FullHermitian),
        hc x.property y.property⟩).val = symmetricMatrixProduct (I x).val (I y).val) ∧
      (∀ i, (I ⟨p i, framePairGenerated_point_left p q i⟩).val = qutritMUBProjection 0 (σ i)) ∧
      (∀ i, (I ⟨q i, framePairGenerated_point_right p q i⟩).val = qutritMUBProjection 1 (τ i)) := by
  have orth := (complex_framePlane_orthogonal_iff F G).mpr unbiased
  have round : IsRound matrixEqualCubic (1 / 6) := by
    refine ⟨by norm_num, fun x => ?_⟩
    rw [matrixEqualCubic_squareMap, TracelessHermitian3.square_norm_sq]
    ring
  have orthUnit (x : TracelessHermitian3) : ⟪complexUnit, complexTraceInclusion x⟫ = 0 := by
    rw [complex_unit_trace]
    change (Matrix.trace x.toMatrix).re = 0
    rw [x.trace_eq_zero, Complex.zero_re]
  obtain ⟨dimW, orthoW, gram, traceless, he, hc, I, σ, τ, hIunit, hItrace, hIprod, hIp, hIq⟩ :=
    twoPlanes_generateComplexQutrit round complexUnit_mul orthUnit
      complex_jordan_split (complexFrameData F) (complexFrameData G)
      (complex_traceJordanFrame F) (complex_traceJordanFrame G) orth F.plane_closed G.plane_closed
      F.plane_dimension G.plane_dimension
  refine ⟨dimW, orthoW, gram, traceless, he, hc, I, σ, τ, hIunit, ?_, hIprod, hIp, hIq⟩
  intro x
  exact (hItrace x).trans (complex_unit_trace (x : FullHermitian))

end

end ThirteenPlanes.JordanFrames
