module

public import ThirteenPlanes.Qutrit.Marked
public import ThirteenPlanes.Quaternionic.NativeFrameShare

@[expose] public section

set_option backward.privateInPublic true

/-! The qutrit generated by actual quaternionic frame idempotents. -/

open scoped RealInnerProductSpace Quaternion

namespace ThirteenPlanes.JordanFrames

noncomputable section

open RoundCubics Peirce QuaternionicMUB AlbertSequential

private theorem quaternion_product_matrix (x y : HermitianHilbert) :
    fullMat (quaternionFullCubic.L x y) = QuaternionicMUB.jordan (fullMat x) (fullMat y) := by
  exact fullMat_ofMatrix _ _

private theorem quaternion_unit_trace (x : HermitianHilbert) :
    ⟪fullUnit, x⟫ = rtrace (fullMat x) := by
  rw [hermitianHilbert_inner]
  change traceForm (fullMat fullUnit) (fullMat x) = _
  rw [fullMat_fullUnit, traceForm_eq_rtrace_mul 1, one_mul]

private theorem quaternion_jordan_split (x y : TracelessHilbert) :
    quaternionFullCubic.L (traceInclusion x) (traceInclusion y) =
      traceInclusion (quaternionTraceCubic.L x y) + (⟪x, y⟫ / 3) • fullUnit := by
  apply fullMat_injective
  rw [quaternion_product_matrix, map_add, map_smul, fullMat_traceInclusion,
    fullMat_traceInclusion, fullMat_traceInclusion, fullMat_fullUnit,
    quaternionTraceCubic_L_matrix, centerMatrix, tracelessHilbert_inner]
  exact (sub_add_cancel _ _).symm

private theorem quaternion_traceJordanFrame (F : Frame) :
    TraceJordanFrame quaternionFullCubic fullUnit (nativeCenteredTraceFrame F).point := by
  refine ⟨?_, ?_, ?_, (nativeCenteredTraceFrame F).point_sum⟩
  · intro i
    rw [quaternion_unit_trace]
    change rtrace (fullMat (fullOfMatrix (F.point i) (F.hermitian i))) = 1
    rw [fullMat_ofMatrix, F.trace_one]
  · intro i
    apply fullMat_injective
    rw [quaternion_product_matrix]
    simpa only [nativeCenteredTraceFrame, fullMat_ofMatrix] using F.idempotent i
  · intro i j hij
    apply fullMat_injective
    rw [quaternion_product_matrix, map_zero]
    simpa only [nativeCenteredTraceFrame, fullMat_ofMatrix] using F.orthogonal i j hij

/-- Proposition qutrit on the literal quaternionic Hermitian trace carrier. -/
theorem quaternionic_framePair_generated_qutrit (F G : Frame) (orth : F.MutuallyUnbiased G) :
    let p := (nativeCenteredTraceFrame F).point
    let q := (nativeCenteredTraceFrame G).point
    let U := F.centeredPlane
    let Y := G.centeredPlane
    let W := mixedProductSpace quaternionTraceCubic U Y
    let S := (U ⊔ Y) ⊔ W
    let A := framePairGenerated quaternionFullCubic fullUnit p q
    Module.finrank ℝ W = 4 ∧ W.IsOrtho (U ⊔ Y) ∧
    (∀ (x x' : U) (y y' : Y), ⟪quaternionTraceCubic.L (x : TracelessHilbert) y,
      quaternionTraceCubic.L (x' : TracelessHilbert) y'⟫ = ((1 : ℝ) / 6 / 2) * (⟪x, x'⟫ * ⟪y, y'⟫)) ∧
    A ⊓ (ℝ ∙ fullUnit)ᗮ = S.map traceInclusion.toLinearMap ∧
    ∃ (he : fullUnit ∈ A) (hc : IsClosedPiece quaternionFullCubic A) (I : A ≃ₗ[ℝ] Hermitian3)
        (σ τ : Equiv.Perm (Fin 3)),
      (I ⟨fullUnit, he⟩).val = 1 ∧
      (∀ x : A, (Matrix.trace (I x).val).re = rtrace (fullMat (x : HermitianHilbert))) ∧
      (∀ x y : A, (I ⟨quaternionFullCubic.L (x : HermitianHilbert) (y : HermitianHilbert),
        hc x.property y.property⟩).val = symmetricMatrixProduct (I x).val (I y).val) ∧
      (∀ i, (I ⟨p i, framePairGenerated_point_left p q i⟩).val = qutritMUBProjection 0 (σ i)) ∧
      (∀ i, (I ⟨q i, framePairGenerated_point_right p q i⟩).val = qutritMUBProjection 1 (τ i)) := by
  have orthUnit (x : TracelessHilbert) : ⟪fullUnit, traceInclusion x⟫ = 0 := by
    rw [quaternion_unit_trace, fullMat_traceInclusion, traceMat_trace]
  obtain ⟨dimW, orthoW, gram, traceless, he, hc, I, σ, τ, hIunit, hItrace, hIprod, hIp, hIq⟩ :=
    twoPlanes_generateComplexQutrit quaternionTraceCubic_round quaternionFullCubic_unit orthUnit
      quaternion_jordan_split (nativeCenteredTraceFrame F) (nativeCenteredTraceFrame G)
      (quaternion_traceJordanFrame F) (quaternion_traceJordanFrame G)
      (Frame.centeredPlane_orthogonal orth) F.centeredPlane_closed G.centeredPlane_closed
      F.centeredPlane_dimension G.centeredPlane_dimension
  refine ⟨dimW, orthoW, gram, traceless, he, hc, I, σ, τ, hIunit, ?_, hIprod, hIp, hIq⟩
  intro x
  exact (hItrace x).trans (quaternion_unit_trace (x : HermitianHilbert))

end

end ThirteenPlanes.JordanFrames
