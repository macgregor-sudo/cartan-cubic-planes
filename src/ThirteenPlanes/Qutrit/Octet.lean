module

public import ThirteenPlanes.Peirce.SlotModelIdentification
public import ThirteenPlanes.Shares.OctetClosure

@[expose] public section

set_option backward.privateInPublic true

/-! The complex trace cubic on the octet generated by a pair of closed planes. -/

open scoped RealInnerProductSpace

namespace ThirteenPlanes.JordanFrames

noncomputable section

open RoundCubics Peirce

variable {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℝ V] [FiniteDimensional ℝ V]
  {h : SymmetricCubic V} {c : ℝ} {U Y : Submodule ℝ V}

/-- The two closed planes and their mixed products span an orthogonal octet. -/
theorem pairOctet_finrank (round : IsRound h c) (orth : U.IsOrtho Y)
    (closed : IsClosedPiece h U) (closed' : IsClosedPiece h Y)
    (dim : Module.finrank ℝ U = 2) (dim' : Module.finrank ℝ Y = 2) :
    Module.finrank ℝ ↥((U ⊔ Y) ⊔ mixedProductSpace h U Y) = 8 := by
  have hM := mixedProductSpace_finrank round orth closed closed' dim dim'
  have hA := Submodule.finrank_sup_add_finrank_inf_eq U Y
  rw [orth.disjoint.eq_bot, finrank_bot, add_zero, dim, dim'] at hA
  have ho : (mixedProductSpace h U Y).IsOrtho (U ⊔ Y) :=
    Submodule.isOrtho_iff_le.mpr (mixedProductSpace_le_orthogonal round orth closed closed')
  have hS := Submodule.finrank_sup_add_finrank_inf_eq (U ⊔ Y) (mixedProductSpace h U Y)
  rw [ho.symm.disjoint.eq_bot, finrank_bot, add_zero, hM, hA] at hS
  exact hS

omit [FiniteDimensional ℝ V] in
theorem product_space_smul (r : ℝ) (hr : r ≠ 0) :
    mixedProductSpace (r • h) U Y = mixedProductSpace h U Y := by
  rw [mixedProductSpace_eq_span, mixedProductSpace_eq_span]
  apply le_antisymm <;> apply Submodule.map₂_le.mpr
  · intro x hx y hy
    change r • h.L x y ∈ _
    exact Submodule.smul_mem _ r (Submodule.apply_mem_map₂ _ hx hy)
  · intro x hx y hy
    have hm := Submodule.apply_mem_map₂ (r • h).L hx hy
    change r • h.L x y ∈ _ at hm
    have ht := Submodule.smul_mem _ r⁻¹ hm
    simpa only [smul_smul, inv_mul_cancel₀ hr, one_smul] using ht

private theorem trace_mixed_diagonals (round : IsRound h 1) (orth : U.IsOrtho Y)
    (closed : IsClosedPiece h U) (closed' : IsClosedPiece h Y)
    (dim : Module.finrank ℝ U = 2)
    (a b : U) (ha : h.L (a : V) a = a) (hab : h.L (a : V) b = -(b : V))
    (y : Y) :
    let p := h.L (a : V) y
    let q := h.L (b : V) y
    (⟪p, h.L (a : V) p⟫ : ℝ) = -(‖p‖ ^ 2) / 2 ∧
      (⟪q, h.L (a : V) q⟫ : ℝ) = ‖q‖ ^ 2 / 2 := by
  dsimp only
  let p := h.L (a : V) y
  let q := h.L (b : V) y
  have mixed (x : U) : h.L (x : V) y ∈ (U ⊔ Y)ᗮ := by
    apply mixedProductSpace_le_orthogonal round orth closed closed'
    rw [mixedProductSpace_eq_span]
    exact Submodule.apply_mem_map₂ _ x.property y.property
  have aY : ⟪(a : V), (y : V)⟫ = 0 := orth.inner_eq a.property y.property
  have bY : ⟪(b : V), (y : V)⟫ = 0 := orth.inner_eq b.property y.property
  have diag (x z : V) (m : V) : ⟪x, h.L z m⟫ = ⟪h.L x z, m⟫ := by
    rw [h.L_comm x z, h.L_isSymmetric z x m]
  change ⟪p, h.L (a : V) p⟫ = -‖p‖ ^ 2 / 2 ∧ ⟪q, h.L (a : V) q⟫ = ‖q‖ ^ 2 / 2
  constructor
  · have hp := polarized round (a : V) a y p
    rw [ha, diag (a : V) y p] at hp
    have hap : ⟪(a : V), p⟫ = 0 :=
      Submodule.inner_right_of_mem_orthogonal ((le_sup_left : U ≤ U ⊔ Y) a.property) (mixed a)
    have hyp : ⟪(y : V), p⟫ = 0 :=
      Submodule.inner_right_of_mem_orthogonal ((le_sup_right : Y ≤ U ⊔ Y) y.property) (mixed a)
    rw [aY, hap, hyp] at hp
    change ⟪p, p⟫ + ⟪p, h.L (a : V) p⟫ + ⟪h.L (a : V) p, p⟫ = _ at hp
    have rev : ⟪h.L (a : V) p, p⟫ = ⟪p, h.L (a : V) p⟫ := real_inner_comm _ _
    rw [real_inner_self_eq_norm_sq, rev] at hp
    simp only [mul_zero, add_zero] at hp
    linarith
  · have hc := congrArg (fun A : Module.End ℝ Uᗮ =>
      (A ⟨(y : V), Submodule.isOrtho_iff_le.mp orth.symm y.property⟩ : V))
      (closedPlane_slices_commute round closed dim a b).eq
    change h.L (a : V) q = h.L (b : V) p at hc
    have cross : ⟪p, h.L (b : V) q⟫ = ⟪q, h.L (a : V) q⟫ := by
      rw [← h.L_isSymmetric (b : V) p q, ← hc, real_inner_comm]
    have hq := polarized round (a : V) b y q
    have haq : ⟪(a : V), q⟫ = 0 :=
      Submodule.inner_right_of_mem_orthogonal ((le_sup_left : U ≤ U ⊔ Y) a.property) (mixed b)
    have hyq : ⟪(y : V), q⟫ = 0 :=
      Submodule.inner_right_of_mem_orthogonal ((le_sup_right : Y ≤ U ⊔ Y) y.property) (mixed b)
    rw [hab, inner_neg_left, diag (b : V) y q] at hq
    change -⟪q, q⟫ + ⟪p, h.L (b : V) q⟫ + ⟪h.L (a : V) q, q⟫ = _ at hq
    have rev : ⟪h.L (a : V) q, q⟫ = ⟪q, h.L (a : V) q⟫ := real_inner_comm _ _
    rw [aY, bY, haq, hyq, cross, real_inner_self_eq_norm_sq, rev] at hq
    simp only [mul_zero, zero_mul, add_zero] at hq
    linarith

set_option maxHeartbeats 1000000 in
theorem pairOctet_isometry_unit (round : IsRound h 1) (orth : U.IsOrtho Y)
    (closed : IsClosedPiece h U) (closed' : IsClosedPiece h Y)
    (dim : Module.finrank ℝ U = 2) (dim' : Module.finrank ℝ Y = 2)
    (a : V) (b : minusSpace h a) (haU : a ∈ U) (hbU : (b : V) ∈ U)
    (ha : IsUnitIdempotent h a) (hb : ‖b‖ = 1) :
    let S := (U ⊔ Y) ⊔ mixedProductSpace h U Y
    ∃ I : S ≃ₗᵢ[ℝ] TracelessHermitian3,
      h.pullback S.subtype = complexCartanCubic.pullback I.toLinearMap := by
  classical
  let W := mixedProductSpace h U Y
  let S := (U ⊔ Y) ⊔ W
  let k := h.pullback S.subtype
  have hclosed := pairOctet_closed round orth closed closed' dim dim'
  have hd := pairOctet_finrank round orth closed closed' dim dim'
  have ka : IsRound k 1 := closedSubspace_restriction_isRound round hclosed
  let u : Fin 2 → U := ![⟨a, haU⟩, ⟨(b : V), hbU⟩]
  let y := (stdOrthonormalBasis ℝ Y).reindex (finCongr dim')
  have habb := markedPlane_normalForm round ha hb
  have haB : ⟪a, (b : V)⟫ = 0 :=
    (spectralSplit round ha).minus_perp.inner_eq (Submodule.mem_span_singleton_self a) b.property
  have hbV : ‖(b : V)‖ = 1 := hb
  have hu : Orthonormal ℝ u := by
    rw [orthonormal_iff_ite]
    intro i j
    fin_cases i <;> fin_cases j
    · change ⟪a, a⟫ = 1
      rw [real_inner_self_eq_norm_sq, ha.norm_eq_one, one_pow]
    · exact haB
    · exact (real_inner_comm _ _).trans haB
    · change ⟪(b : V), (b : V)⟫ = 1
      rw [real_inner_self_eq_norm_sq, hbV, one_pow]
  have uS : U ≤ S := le_sup_left.trans le_sup_left
  have yS : Y ≤ S := le_sup_right.trans le_sup_left
  have wS : W ≤ S := le_sup_right
  have prod_mem (x : U) (v : Y) : h.L (x : V) v ∈ W := by
    rw [show W = mixedProductSpace h U Y from rfl, mixedProductSpace_eq_span]
    exact Submodule.apply_mem_map₂ _ x.property v.property
  let w (i : Fin 2 × Fin 2) : V := Real.sqrt 2 • h.L (u i.1 : V) (y i.2 : V)
  have wW (i : Fin 2 × Fin 2) : w i ∈ W := W.smul_mem _ (prod_mem (u i.1) (y i.2))
  have wO : W.IsOrtho (U ⊔ Y) :=
    Submodule.isOrtho_iff_le.mpr (mixedProductSpace_le_orthogonal round orth closed closed')
  let Index := Fin 2 ⊕ Fin 2 ⊕ (Fin 2 × Fin 2)
  let e : Index → S := Sum.elim (fun i => ⟨u i, uS (u i).property⟩)
    (Sum.elim (fun i => ⟨y i, yS (y i).property⟩) (fun i => ⟨w i, wS (wW i)⟩))
  have hs2 : Real.sqrt 2 * Real.sqrt 2 = 2 := Real.mul_self_sqrt (by norm_num)
  have he : Orthonormal ℝ e := by
    rw [orthonormal_iff_ite]
    rintro (i | (i | i)) (j | (j | j))
    · change ⟪u i, u j⟫ = if (Sum.inl i : Index) = Sum.inl j then 1 else 0
      simpa only [Sum.inl.injEq] using orthonormal_iff_ite.mp hu i j
    · exact orth.inner_eq (u i).property (y j).property
    · exact wO.symm.inner_eq ((le_sup_left : U ≤ U ⊔ Y) (u i).property) (wW j)
    · exact orth.symm.inner_eq (y i).property (u j).property
    · change ⟪y i, y j⟫ = if (Sum.inr (Sum.inl i) : Index) = Sum.inr (Sum.inl j) then 1 else 0
      simpa only [Sum.inr.injEq, Sum.inl.injEq] using orthonormal_iff_ite.mp y.orthonormal i j
    · exact wO.symm.inner_eq ((le_sup_right : Y ≤ U ⊔ Y) (y i).property) (wW j)
    · exact wO.inner_eq (wW i) ((le_sup_left : U ≤ U ⊔ Y) (u j).property)
    · exact wO.inner_eq (wW i) ((le_sup_right : Y ≤ U ⊔ Y) (y j).property)
    · change ⟪w i, w j⟫ = if Sum.inr (Sum.inr i) = (Sum.inr (Sum.inr j) : Index) then 1 else 0
      simp only [w, real_inner_smul_left, real_inner_smul_right, ← mul_assoc, hs2,
        mixedProduct_gram round orth closed closed' dim, orthonormal_iff_ite.mp hu,
        orthonormal_iff_ite.mp y.orthonormal, Sum.inr.injEq, Prod.ext_iff]
      by_cases h₁ : i.1 = j.1 <;> by_cases h₂ : i.2 = j.2 <;> norm_num [h₁, h₂]
  have card : Fintype.card Index = Module.finrank ℝ S := by
    rw [show Module.finrank ℝ S = 8 from hd]
    norm_num [Index]
  let B := basisOfOrthonormalOfCardEqFinrank he card
  have hB : ⇑B = e := coe_basisOfOrthonormalOfCardEqFinrank he card
  let E := B.toOrthonormalBasis (by rw [hB]; exact he)
  have hE : ⇑E = e := (Module.Basis.coe_toOrthonormalBasis B _).trans hB
  let aS : S := ⟨a, uS haU⟩
  let bS : S := ⟨b, uS hbU⟩
  have hka : IsUnitIdempotent k aS := ⟨ha.norm_eq_one, Subtype.ext (by
    rw [closedSubspace_restriction_product hclosed]; exact ha.square_eq_self)⟩
  have hkb : bS ∈ minusSpace k aS := Module.End.mem_eigenspace_iff.mpr (by
    apply Subtype.ext
    rw [closedSubspace_restriction_product hclosed]
    simpa using habb.1)
  have trace : LinearMap.trace ℝ S (k.L aS) = 0 := by
    rw [SymmetricCubic.trace_eq_sum_inner E, hE, Fintype.sum_sum_type, Fintype.sum_sum_type]
    have entry (i : Index) :
        ⟪e i, k.L aS (e i)⟫ = ⟪(e i : V), h.L a (e i : V)⟫ := by
      change ⟪(e i : V), (k.L aS (e i) : V)⟫ = _
      rw [closedSubspace_restriction_product hclosed]
    simp only [entry]
    have first : (∑ i : Fin 2, ⟪(e (Sum.inl i) : V), h.L a (e (Sum.inl i) : V)⟫) = 0 := by
      rw [Fin.sum_univ_two]
      change ⟪a, h.L a a⟫ + ⟪(b : V), h.L a (b : V)⟫ = 0
      rw [ha.square_eq_self, habb.1, inner_neg_right, real_inner_self_eq_norm_sq,
        real_inner_self_eq_norm_sq, ha.norm_eq_one, hbV]
      norm_num
    have second : (∑ i : Fin 2, ⟪(e (Sum.inr (Sum.inl i)) : V), h.L a (e (Sum.inr (Sum.inl i)) : V)⟫) = 0 := by
      apply Finset.sum_eq_zero
      intro i _
      change ⟪(y i : V), h.L a (y i : V)⟫ = 0
      exact wO.symm.inner_eq ((le_sup_right : Y ≤ U ⊔ Y) (y i).property) (prod_mem (u 0) (y i))
    have last : (∑ i : Fin 2 × Fin 2,
        ⟪(e (Sum.inr (Sum.inr i)) : V), h.L a (e (Sum.inr (Sum.inr i)) : V)⟫) = 0 := by
      rw [Fintype.sum_prod_type_right]
      apply Finset.sum_eq_zero
      intro i _
      rw [Fin.sum_univ_two]
      change ⟪w (0, i), h.L a (w (0, i))⟫ + ⟪w (1, i), h.L a (w (1, i))⟫ = 0
      have hdi := trace_mixed_diagonals round orth closed closed' dim (u 0) (u 1)
        ha.square_eq_self habb.1 (y i)
      have hn (j : Fin 2) : ‖h.L (u j : V) (y i : V)‖ ^ 2 = 1 / 2 := by
        rw [← real_inner_self_eq_norm_sq, mixedProduct_gram round orth closed closed' dim,
          orthonormal_iff_ite.mp hu, orthonormal_iff_ite.mp y.orthonormal]
        norm_num
      dsimp only at hdi
      simp only [w, map_smul, real_inner_smul_left, real_inner_smul_right, ← mul_assoc, hs2]
      change 2 * ⟪h.L (u 0 : V) (y i : V), h.L (u 0 : V) (h.L (u 0 : V) (y i : V))⟫ +
        2 * ⟪h.L (u 1 : V) (y i : V), h.L (u 0 : V) (h.L (u 1 : V) (y i : V))⟫ = 0
      rw [hdi.1, hdi.2, hn 0, hn 1]
      norm_num
    rw [first, second, last]
    norm_num
  obtain ⟨I, _, _, hI⟩ := markedRoundCubic_complex (b := ⟨bS, hkb⟩) ka hka hb trace hd
  exact ⟨I, hI⟩

/-- Corollary 3-octet at arbitrary positive round strength. -/
theorem pairOctet_ofRoundPlaneSystem {ι : Type*} {planes : PlaneDecomposition V ι}
    (round : IsRound h c) (closed : IsClosedPlaneSystem h planes) {i j : ι} (hij : i ≠ j) :
    let S := (planes.plane i ⊔ planes.plane j) ⊔ mixedProductSpace h (planes.plane i) (planes.plane j)
    IsClosedPiece h S ∧ ∃ I : S ≃ₗᵢ[ℝ] TracelessHermitian3,
      h.pullback S.subtype = Real.sqrt c • complexCartanCubic.pullback I.toLinearMap := by
  dsimp only
  let t := Real.sqrt c
  have ht : 0 < t := Real.sqrt_pos.mpr round.positive
  let g := t⁻¹ • h
  have hg : IsRound g 1 := by
    refine ⟨by norm_num, fun x => ?_⟩
    change ‖(t⁻¹ • h).squareMap x‖ ^ 2 = _
    have hscale : (t⁻¹) ^ 2 * c = 1 := by
      rw [inv_pow, show t ^ 2 = c from Real.sq_sqrt round.positive.le,
        inv_mul_cancel₀ round.positive.ne']
    rw [SymmetricCubic.squareMap_smul, norm_smul, mul_pow, Real.norm_of_nonneg (inv_nonneg.mpr ht.le),
      round.square_norm, ← mul_assoc, hscale, one_mul]
  have hgc : IsClosedPlaneSystem g planes := by
    intro k x y hx hy
    change (t⁻¹ • h).L x y ∈ planes.plane k
    simpa only [map_smul, LinearMap.smul_apply] using (planes.plane k).smul_mem t⁻¹ (closed k hx hy)
  obtain ⟨a, b, hai, hbi, ha, hb⟩ := markedPair_of_closed_plane hg hgc i
  have orth := planes.pairwise_orthogonal hij
  have H := pairOctet_isometry_unit hg orth (hgc i) (hgc j)
    (planes.dimension i) (planes.dimension j) a b hai hbi ha hb
  dsimp only at H
  rw [show mixedProductSpace g (planes.plane i) (planes.plane j) = _ from
    product_space_smul t⁻¹ (inv_ne_zero ht.ne')] at H
  refine ⟨pairOctet_closed round orth (closed i) (closed j) (planes.dimension i) (planes.dimension j), ?_⟩
  obtain ⟨I, hI⟩ := H
  refine ⟨I, ?_⟩
  have hh : h = t • g := by
    change h = t • (t⁻¹ • h)
    rw [smul_smul, mul_inv_cancel₀ ht.ne', one_smul]
  apply SymmetricCubic.ext
  intro x y z
  rw [SymmetricCubic.pullback_apply, SymmetricCubic.apply_smul, SymmetricCubic.pullback_apply]
  calc
    _ = (t • g).apply (x : V) (y : V) (z : V) :=
      congrArg (fun p : SymmetricCubic V => p.apply (x : V) (y : V) (z : V)) hh
    _ = _ := by
      rw [SymmetricCubic.apply_smul]
      congr 1
      have he := congrArg (fun p => SymmetricCubic.apply p x y z) hI
      rw [SymmetricCubic.pullback_apply, SymmetricCubic.pullback_apply] at he
      exact he

end

end ThirteenPlanes.JordanFrames
